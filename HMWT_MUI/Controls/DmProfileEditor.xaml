<UserControl x:Class="HMWT_MUI.Controls.DmProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="DmField" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DmBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DmPrimaryBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="{StaticResource B.Void}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{StaticResource B.Gold}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Затемнение на всё окно владельца -->
    <Grid x:Name="rootOverlay" Background="#D906060A">
        <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.GoldSoft}" BorderThickness="1" CornerRadius="12"
                Padding="24" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="ПРОФИЛЬ В ОТРЯДЕ" FontFamily="Cinzel, Segoe UI" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource B.Gold}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtSubtitleHint" Text="Так вас увидят в отряде."
                           Foreground="{StaticResource B.Mute}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,18"/>

                <!-- Аватар: настоящий круг.
                     У Border со скруглением углов содержимое НЕ обрезается,
                     поэтому квадратная картинка вылезала за края круга.
                     Круг даёт Clip с эллипсом. -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="76" Height="76" Margin="0,0,16,0">
                        <Ellipse Fill="{StaticResource B.Slate}" Stroke="{StaticResource B.GoldSoft}" StrokeThickness="1"/>
                        <!-- Обрезка в круг: Clip с эллипсом. Через CornerRadius
                             у Border содержимое НЕ обрезается, поэтому квадратная
                             картинка вылезала за края. -->
                        <Grid x:Name="avatarClip" Width="72" Height="72">
                            <Grid.Clip>
                                <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36"/>
                            </Grid.Clip>
                            <TextBlock x:Name="txtAvatarLetter" Text="?" FontFamily="Cinzel, Segoe UI" FontSize="30"
                                       FontWeight="Bold" Foreground="{StaticResource B.Gold}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="imgAvatar" Stretch="UniformToFill"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="btnChoosePhoto" Content="Выбрать аватар" Style="{StaticResource DmBtn}"
                                HorizontalAlignment="Left" Click="BtnChoosePhoto_Click"/>
                        <Button x:Name="btnClearPhoto" Content="Убрать аватар" Style="{StaticResource DmBtn}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" FontSize="11"
                                Foreground="{StaticResource B.Danger}" Click="BtnClearPhoto_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Никнейм -->
                <TextBlock Text="Никнейм в отряде" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="txtName" Style="{StaticResource DmField}" MaxLength="40" MinHeight="38"/>

                <!-- Подпись -->
                <TextBlock Text="Подпись (например: воин 3 уровня)" Foreground="{StaticResource B.Mute}"
                           FontSize="11" Margin="0,12,0,4"/>
                <TextBox x:Name="txtSubtitle" Style="{StaticResource DmField}" MaxLength="60" MinHeight="38"/>

                <TextBlock x:Name="txtHint" Text="" Foreground="{StaticResource B.Danger}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                <!-- Кнопки -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Отмена" Style="{StaticResource DmBtn}" Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>
                    <Button Grid.Column="1" Content="Сохранить" Style="{StaticResource DmPrimaryBtn}" Margin="8,0,0,0"
                            Click="BtnSave_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
