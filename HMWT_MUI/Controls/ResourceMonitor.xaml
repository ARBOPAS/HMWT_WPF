<UserControl x:Class="HMWT_MUI.Controls.ResourceMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel>
        <!-- Память приложения: именно она важна для гифок -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Память приложения (как в диспетчере задач)" FontSize="11" Foreground="{StaticResource B.Mute}"/>
                <TextBlock x:Name="txtProcessMemory" Text="—" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource B.Accent}"
                           ToolTip="Приватный рабочий набор процесса: то же число, что в столбце «Память» диспетчера задач"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="txtGifCache" Text="" FontSize="10"
                       Foreground="{StaticResource B.Mute}" VerticalAlignment="Bottom"
                       TextAlignment="Right"/>
        </Grid>

        <!-- Память компьютера -->
        <TextBlock Text="Память компьютера" FontSize="11" Foreground="{StaticResource B.Mute}" Margin="0,0,0,4"/>
        <ProgressBar x:Name="barMemory" Style="{StaticResource RmBar}" Margin="0,0,0,4"/>
        <TextBlock x:Name="txtSystemMemory" Text="—" FontSize="11"
                   Foreground="{StaticResource B.Ink}" Margin="0,0,0,12"/>

        <!-- Процессор -->
        <TextBlock Text="Процессор (загрузка приложением)" FontSize="11"
                   Foreground="{StaticResource B.Mute}" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="barCpu" Style="{StaticResource RmBar}"
                         Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="txtCpu" Text="—" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource B.Frost}" Margin="10,0,0,0"/>
        </Grid>

        <TextBlock Text="Если память растёт при просмотре списков — понизьте качество анимации гифок выше."
                   FontSize="10" Foreground="{StaticResource B.Mute}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
