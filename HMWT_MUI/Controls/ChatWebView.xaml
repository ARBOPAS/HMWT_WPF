<UserControl x:Class="HMWT_MUI.Controls.ChatWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="#0B0D16">
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
        <TextBlock x:Name="Fallback"
                   Text="WebView2 не запустился — лента остаётся в обычном виде."
                   Foreground="#8B95B4" FontSize="12" TextWrapping="Wrap"
                   Margin="16" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
