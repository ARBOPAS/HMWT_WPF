<UserControl x:Class="HMWT_MUI.Controls.ChatGifPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430" Height="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="30" FontSize="12"
                     Style="{StaticResource SearchBox}" Tag="Поиск по имени"
                     TextChanged="Search_TextChanged"/>
            <Button Grid.Column="1" Content="Добавить…" Height="30" Margin="8,0,0,0"
                    Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" Click="Add_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="1" CornerRadius="8" Padding="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="TilesHost" Orientation="Horizontal"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="Пока пусто. Отправьте гифку в чат или нажмите «Добавить…»."
                           FontSize="11" Foreground="{StaticResource B.Mute}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="10.5" Foreground="{StaticResource B.Mute}"
                   Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
