<Window x:Class="HMWT_MUI.Windows.NotePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI, Calibri"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="RootBorder" Background="#1B1A26" BorderBrush="#E0AE4E" BorderThickness="2" CornerRadius="12" Padding="24">
        <Grid Width="420">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Заголовок"
                       FontFamily="Segoe UI Semibold, Segoe UI" FontSize="18" FontWeight="Bold"
                       Foreground="#4FB6AC" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <TextBlock x:Name="MessageText" Grid.Row="1" Text=""
                       FontSize="13" Foreground="#8B859C" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed"/>

            <TextBox x:Name="InputBox" Grid.Row="2"
                     Background="#15151F" Foreground="#ECE4D0" CaretBrush="#E0AE4E"
                     BorderBrush="#322E44" BorderThickness="1" Padding="10,8"
                     FontSize="14" Margin="0,0,0,16"
                     KeyDown="InputBox_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click"
                        Background="#232132" Foreground="#ECE4D0" BorderThickness="0"
                        Padding="16,8" Margin="0,0,10,0" Cursor="Hand"/>
                <Button x:Name="OkButton" Content="ОК" Click="Ok_Click" IsDefault="True"
                        Background="#4FB6AC" Foreground="#0C0C12" BorderThickness="0"
                        Padding="16,8" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
