<Window x:Class="HMWT_MUI.Windows.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
        Title="Иконка" Width="620" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True">
    <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ИКОНКА В ЧАТ" FontFamily="{StaticResource F.Display}" FontSize="18"
                               FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Text="Иконки приложения отправляются как картинка — без эмодзи-символов."
                               FontSize="11" Foreground="{StaticResource B.Mute}" Margin="0,3,12,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" VerticalAlignment="Top"
                        Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                        BorderThickness="1" Click="Close_Click" ToolTip="Закрыть">
                    <helpers:IconView Kind="close" IconSize="14" IconBrush="{StaticResource B.Mute}"
                                      VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Height="32" FontSize="12.5"
                     Style="{StaticResource SearchBox}" Tag="Поиск по названию иконки"
                     TextChanged="Search_TextChanged" Margin="0,0,0,10"/>

            <Border Grid.Row="2" Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="8" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IconsHost" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource B.Mute}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Отправить" Height="36" Width="140"
                        Style="{StaticResource ActionBtn}" Click="Send_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
