<Window x:Class="HMWT_MUI.Windows.SummonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
        Title="Призывы" Width="900" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SummonItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="2,2"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Slate}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatBox" TargetType="TextBox" BasedOn="{StaticResource TextField}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ПРИЗЫВЫ" FontFamily="{StaticResource F.Display}" FontSize="19"
                               FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Text="Существа, которыми управляет ваш персонаж: краткий лист, картинка и жетон на карте."
                               FontSize="11" Foreground="{StaticResource B.Mute}" Margin="0,3,12,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" VerticalAlignment="Top"
                        Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                        BorderThickness="1" Click="Close_Click" ToolTip="Закрыть">
                    <helpers:IconView Kind="close" IconSize="14" IconBrush="{StaticResource B.Mute}"
                                      VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Слева: поиск и список -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBox x:Name="SearchBox" Height="32" FontSize="12.5"
                             Style="{StaticResource SearchBox}" Tag="Поиск по имени"
                             TextChanged="Search_TextChanged" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1" CornerRadius="8" Padding="2" Height="486">
                        <Grid>
                            <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SummonItem}"
                                     SelectionChanged="List_SelectionChanged">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                                </ListBox.Resources>
                            </ListBox>
                            <TextBlock x:Name="EmptyText" Text="Пока пусто. Нажмите «Новый»."
                                       FontSize="11" Foreground="{StaticResource B.Mute}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{StaticResource B.Mute}"
                               Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Справа: краткий лист -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Имя" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource TextField}" MinHeight="34" Margin="0,0,0,10"/>

                        <TextBlock Text="Тип существа" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TypeBox" Style="{StaticResource TextField}" MinHeight="34" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Размер" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SizeBox" Style="{StaticResource DarkComboBox}" MinHeight="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="ХП" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="HpBox" Style="{StaticResource StatBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="ХП макс" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="MaxHpBox" Style="{StaticResource StatBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="КД" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="AcBox" Style="{StaticResource StatBox}" Text="0" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Скорость" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="SpeedBox" Style="{StaticResource TextField}" MinHeight="34" Margin="0,0,0,10"/>

                        <TextBlock Text="Характеристики" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="СИЛ" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="StrBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="ЛОВ" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="DexBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="ТЕЛ" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="ConBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                <TextBlock Text="ИНТ" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="IntBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                <TextBlock Text="МДР" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="WisBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="ХАР" Foreground="{StaticResource B.Mute}" FontSize="9.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="ChaBox" Style="{StaticResource StatBox}" Text="10" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Атаки" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="AttacksBox" Style="{StaticResource AreaField}" Height="62"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Особенности" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="AbilitiesBox" Style="{StaticResource AreaField}" Height="62"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Картинка" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" Background="{StaticResource B.Slate}"
                                    BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                    CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PhotoPreview" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="PhotoHint" Text="нет фото" FontSize="10"
                                               Foreground="{StaticResource B.Mute}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PickPhotoButton" Content="Выбрать…" Height="30"
                                            Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                                            BorderThickness="1" Click="PickPhoto_Click"/>
                                    <Button x:Name="ClearPhotoButton" Content="Убрать" Height="30" Margin="8,0,0,0"
                                            Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                                            BorderThickness="1" Visibility="Collapsed"
                                            Click="ClearPhoto_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrorText" Foreground="{StaticResource B.Danger}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Низ: действия -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Новый" Height="38" Width="96"
                            Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1" Click="New_Click"/>
                    <Button Content="Удалить" Height="38" Width="96" Margin="8,0,0,0"
                            Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1" Click="Delete_Click"/>
                    <Button Content="Пример: водный элементаль" Height="38" Margin="8,0,0,0"
                            Style="{StaticResource GhostBtn}" Click="Preset_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="На карту" Height="38" Width="120" Margin="0,0,8,0"
                            Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Accent}"
                            BorderThickness="1" Click="Place_Click"/>
                    <Button Content="Сохранить" Height="38" Width="140"
                            Style="{StaticResource ActionBtn}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
