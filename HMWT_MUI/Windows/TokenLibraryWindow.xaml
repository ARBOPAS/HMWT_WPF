<Window x:Class="HMWT_MUI.Windows.TokenLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека жетонов"
        Width="800" Height="560"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI, Calibri"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}"
            BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="БИБЛИОТЕКА ЖЕТОНОВ" FontFamily="{StaticResource F.Display}"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Text="Бочка, стол, старик — что угодно с картинкой. Двойной клик ставит жетон на карту."
                               FontSize="11.5" Foreground="{StaticResource B.Mute}"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBox x:Name="SearchBox" Width="210" Height="33" FontSize="12.5"
                             Style="{StaticResource SearchBox}" Tag="Поиск по имени"
                             Margin="0,0,8,0" TextChanged="Search_TextChanged"/>
                    <Button Content="Добавить…" Click="Add_Click"
                            Style="{StaticResource GhostBtn}" Height="32" MinWidth="110"/>
                </StackPanel>
            </Grid>

            <!-- Плитки -->
            <Border Grid.Row="1" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="TilesHost" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyText"
                               Text="Пока пусто. Нажмите «Добавить…» и выберите картинку — бочку, сундук, портрет НПС."
                               FontSize="12" Foreground="{StaticResource B.Mute}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Низ -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Картинка…" Click="ReplaceImage_Click"
                            Style="{StaticResource GhostBtn}" Height="32" MinWidth="110"
                            Margin="0,0,8,0"/>
                    <Button Content="Переименовать…" Click="Rename_Click"
                            Style="{StaticResource GhostBtn}" Height="32" MinWidth="130"
                            Margin="0,0,8,0"/>
                    <Button Content="Удалить" Click="Delete_Click"
                            Style="{StaticResource GhostBtn}" Height="32" MinWidth="90"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Column="1" Text=""
                           FontSize="11" Foreground="{StaticResource B.Mute}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Закрыть" Click="Close_Click"
                            Style="{StaticResource GhostBtn}" Height="34" MinWidth="96"
                            Margin="0,0,10,0"/>
                    <Button Content="На карту" Click="Place_Click"
                            Style="{StaticResource MagicBtn}" Height="34" MinWidth="120"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
