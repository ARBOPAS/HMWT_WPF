<Window x:Class="HMWT_MUI.Windows.DefensePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
        Title="Защита персонажа" Width="480" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Строка справочника: скруглённая, с подсветкой под курсором и
             акцентной рамкой у выбранной. Системный вид ListBox не подходил:
             он рисовал белые строки и толстый светлый скроллбар. -->
        <Style x:Key="DefenseItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Slate}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка: тянется мышью, крестик закрывает как «Отмена» -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Защита персонажа" FontFamily="{StaticResource F.Display}"
                               FontSize="19" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Text="Уязвимость, сопротивление или иммунитет — из справочника или своё название."
                               FontSize="11" Foreground="{StaticResource B.Mute}"
                               TextWrapping="Wrap" Margin="0,3,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" VerticalAlignment="Top"
                        Style="{StaticResource SoftBtn}" BorderBrush="{StaticResource B.Line}"
                        BorderThickness="1" Click="Cancel_Click" ToolTip="Закрыть">
                    <helpers:IconView Kind="close" IconSize="14" IconBrush="{StaticResource B.Mute}"
                                      VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <TextBlock Text="Что добавляем" Grid.Row="1" Foreground="{StaticResource B.Mute}"
                       FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbKind" Grid.Row="2" Height="36" Margin="0,0,0,14"
                      Style="{StaticResource DarkComboBox}"
                      ItemContainerStyle="{StaticResource DmComboBoxItem}"
                      SelectionChanged="Kind_SelectionChanged"/>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Справочник" Foreground="{StaticResource B.Mute}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtOrderHint" Grid.Column="1" Text="сначала физический урон"
                               Foreground="{StaticResource B.Frost}" FontSize="10" FontStyle="Italic"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <ListBox x:Name="lstCatalog" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource B.Ink}" FontSize="13"
                             Padding="0"
                             ItemContainerStyle="{StaticResource DefenseItem}"
                             MouseDoubleClick="Catalog_MouseDoubleClick">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                        </ListBox.Resources>
                    </ListBox>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <TextBlock Text="Или своё название" Foreground="{StaticResource B.Mute}"
                           FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCustom" Height="36" Style="{StaticResource TextField}"
                         Tag="хоумбрю, особый материал, проклятие…"/>
                <TextBlock x:Name="txtError" Foreground="{StaticResource B.Danger}" FontSize="11"
                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Content="ОТМЕНА" Height="40" Width="130"
                        HorizontalAlignment="Left"
                        Style="{StaticResource OverlaySecondaryBtn}" Click="Cancel_Click"/>
                <Button x:Name="btnAdd" Grid.Column="1" Content="ДОБАВИТЬ" Width="160" Height="40"
                        Style="{StaticResource OverlayPrimaryBtn}" Click="Add_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
