<Window x:Class="HMWT_MUI.Windows.DefensePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Защита персонажа" Width="470" Height="590"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B.Panel}" Foreground="{StaticResource B.Ink}"
        FontFamily="{StaticResource F.Body}" UseLayoutRounding="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Защита персонажа" Grid.Row="0"
                   FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource B.Accent}" Margin="0,0,0,16"/>

        <TextBlock Text="Что добавляем" Grid.Row="1" Foreground="{StaticResource B.Mute}"
                   FontSize="12" Margin="0,0,0,6"/>
        <ComboBox x:Name="cmbKind" Grid.Row="2" Height="38" Margin="0,0,0,14"
                  Style="{StaticResource DarkComboBox}"
                  ItemContainerStyle="{StaticResource DmComboBoxItem}"
                  SelectionChanged="Kind_SelectionChanged"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Справочник" Grid.Row="0" Foreground="{StaticResource B.Mute}"
                       FontSize="12" Margin="0,0,0,6"/>
            <ListBox x:Name="lstCatalog" Grid.Row="1"
                     Background="{StaticResource B.Void}" Foreground="{StaticResource B.Ink}"
                     BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                     Padding="4" FontSize="14"
                     MouseDoubleClick="Catalog_MouseDoubleClick"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Или своё название" Foreground="{StaticResource B.Mute}"
                       FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="txtCustom" Height="38" Style="{StaticResource TextField}"
                     Tag="хоумбрю, особый материал, проклятие…"/>
            <TextBlock x:Name="txtError" Foreground="{StaticResource B.Danger}" FontSize="12"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Content="ОТМЕНА" Width="120" Height="40"
                    Style="{StaticResource OverlaySecondaryBtn}" Click="Cancel_Click"/>
            <Button x:Name="btnAdd" Grid.Column="1" Content="ДОБАВИТЬ" Width="150" Height="40"
                    Style="{StaticResource OverlayPrimaryBtn}" Click="Add_Click"/>
        </Grid>
    </Grid>
</Window>
