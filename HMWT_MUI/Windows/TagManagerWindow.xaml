<Window x:Class="HMWT_MUI.Windows.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/HmwtLogo.ico"
        Title="Управление тегами" Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#2A2A2A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список тегов" FontSize="16" FontWeight="Bold" 
                   Foreground="White" Margin="0,0,0,10"/>

        <ListBox x:Name="lbTags" Grid.Row="1" Background="#3A3A3A" Foreground="White" 
                 BorderThickness="1" BorderBrush="#555" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtNewTag" Grid.Column="0" Height="30" Background="#3A3A3A" 
                         Foreground="White" BorderThickness="1" BorderBrush="#555" Padding="5" 
                         Margin="0,0,5,0"/>
                <Button x:Name="btnAddTag" Grid.Column="1" Content="Добавить" Width="100" Height="30" 
                        Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <Button x:Name="btnDeleteTag" Content="Удалить выбранный" Height="35" 
                    Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>

            <Button x:Name="btnClose" Content="Закрыть" Height="35" 
                    Background="#555" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>