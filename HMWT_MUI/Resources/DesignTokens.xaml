<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:HMWT_MUI.Helpers">

    <!--
      Размеры, которые лист персонажа и его окно подгоняют под ширину окна:
      они пересчитываются кодом (см. ApplyAdaptiveSizes). Значения здесь — то,
      что получают все остальные: стили общие, и без значения по умолчанию
      элемент, у которого вкладка ничего не пересчитывала, остался бы без размера.
    -->
    <sys:Double x:Key="SZ.RoundBtn">34</sys:Double>
    <sys:Double x:Key="SZ.DiceBtn">28</sys:Double>
    <sys:Double x:Key="SZ.ActionBtnHeight">32</sys:Double>
    <sys:Double x:Key="SZ.Avatar">96</sys:Double>
    <sys:Double x:Key="FS.Name">18</sys:Double>
    <sys:Double x:Key="FS.Sub">13</sys:Double>
    <sys:Double x:Key="FS.StatLabel">9</sys:Double>
    <sys:Double x:Key="FS.StatValue">16</sys:Double>
    <sys:Double x:Key="FS.AbilityTitle">13</sys:Double>
    <sys:Double x:Key="FS.AbilityScore">36</sys:Double>
    <sys:Double x:Key="FS.AbilityMod">16</sys:Double>
    <sys:Double x:Key="FS.RowText">12</sys:Double>
    <sys:Double x:Key="FS.RowValue">13</sys:Double>
    <sys:Double x:Key="FS.SaveText">13</sys:Double>
    <sys:Double x:Key="FS.ButtonText">12</sys:Double>
    <sys:Double x:Key="FS.TabText">13</sys:Double>
    <Thickness x:Key="TH.AbilityCardPadding">10</Thickness>
    <Thickness x:Key="TH.SkillRowPadding">8,6</Thickness>
    <Thickness x:Key="TH.StatPadding">10,6,10,6</Thickness>
    <Thickness x:Key="TH.HeaderPadding">18,12,18,12</Thickness>

    <!--
      ═══ ТОКЕНЫ ДИЗАЙНА ═══

      Один источник цветов и шрифтов для всего приложения.

      Раньше каждый вид и каждое окно описывали их заново. Из-за этого вложенный
      вид (например, вкладка «Отряд») не мог загрузиться вне своего окна и падал
      с «Cannot find resource B.Panel», а кастомные диалоги не работали вовсе.

      Значения совпадают с теми, что были в окнах, поэтому внешний вид не меняется.
      Если окно объявляет свой токен, оно по-прежнему его переопределяет.
    -->

    <!--
      Цвета, кисти и шрифты вынесены в Palette.Dark.xaml / Palette.Light.xaml:
      здесь остаются только стили, чтобы палитру можно было менять целиком.
    -->


    <!--
      ═══ ПОЛОСЫ ПРОКРУТКИ ═══

      Своя полоса вместо системной. Системная при уменьшенном масштабе выглядит
      громоздко и «выпирает» из панелей: у неё фиксированная ширина со стрелками,
      которая не сжимается вместе с содержимым.

      Здесь тонкая полоса: узкий желобок и скруглённый ползунок, который
      подсвечивается при наведении. Ширина 13 точек (8 по умолчанию + 5 по
      просьбе пользователя) вместо системных 17.
    -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" CornerRadius="6" Margin="2"
                            Background="{StaticResource B.Line}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Желобок: только фон, без стрелок -->
    <Style x:Key="ThinScrollTrack" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Полоса прокрутки. Была 8 точек — по просьбе пользователя сделана на 5 шире
      (13), потому что за узкий ползунок было трудно взяться мышью.
    -->
    <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="MinWidth" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollTrack}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollTrack}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Полоса не мешает, пока на неё не навели курсор -->
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Горизонтальная полоса: те же стили, но узкая по высоте (тоже +5 к прежним 8) -->
    <Style x:Key="DarkScrollBarHorizontal" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="MinHeight" Value="13"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollTrack}"
                                              Command="ScrollBar.PageLeftCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollTrack}"
                                              Command="ScrollBar.PageRightCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Применяем тонкие полосы ко ВСЕМ полосам прокрутки приложения.
      Неявный стиль по типу с ключом-типом действует везде, где полоса
      создаётся шаблоном ScrollViewer, поэтому отдельно ничего подключать не надо.
    -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

    <!--
      Флажок с отметкой.

      Системный CheckBox в тёмной теме — светлый квадратик, который выбивается
      из окна, поэтому отметка нарисована сама. Стиль лежит в общих токенах:
      шапка листа персонажа и списки отметок собираются в разных местах, а
      рисовать один и тот же флажок заново в каждом из них не за чем.
    -->
    <Style x:Key="CustomCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="checkBorder" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                            <helpers:IconView x:Name="checkMark" Kind="check" IconSize="14" Thickness="2.6"
                                              IconBrush="{StaticResource B.Accent}" Visibility="Collapsed"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource B.Arcane}"/>
                            <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource B.PanelHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ═══ ПОЛЯ ВВОДА ═══

      Однострочное и многострочное поля лежат здесь, а не в каждой вкладке:
      раньше их описывали заново в трёх местах, и копии успели разойтись —
      в заклинаниях поле осталось без рамки и золотой каретки, потому что там
      от стиля были одни цвета. Выглядело это как чужие поля посреди окна.

      Размеры и отступы взяты у самой полной копии, поэтому лист персонажа
      и инвентарь выглядят как раньше.
    -->
    <Style x:Key="TextField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.Slate}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Многострочное поле: то же самое, но с переносом строк и своей прокруткой.
      Отдельным ключом, а не общим с TextField, потому что перенос строк —
      свойство самого поля, и задавать его каждому месту вручную значит
      повторять ту же ошибку.
    -->
    <Style x:Key="AreaField" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.Slate}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ═══ КНОПКИ ═══

      Раньше каждая вкладка описывала их заново, и копии успели разойтись:
      под одним именем GhostBtn в одной вкладке жила кнопка с рамкой, в другой —
      залитая серая, в третьей — просто текст без рамки. Здесь они разведены по
      назначению, чтобы по имени было видно, какая перед тобой кнопка.
    -->

    <!--
      Главная кнопка действия: золотая, с потемнением при наведении.
      Цвет и отступы берутся из свойств кнопки, поэтому вкладка может их
      переопределить, не заводя вторую копию стиля.
    -->
    <Style x:Key="ActionBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.OnAccent}"/>
        <Setter Property="Background" Value="{StaticResource B.Accent}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Кнопка с рамкой: второстепенное действие рядом с главным. Прозрачная,
      рамка и текст подсвечиваются золотом при наведении.
    -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Кнопка-текст без рамки: «закрыть», «сбросить», «отмена». Рамку такому
      действию рисовать не за что, но отклик на наведение всё равно нужен —
      иначе непонятно, что по надписи можно нажать.
    -->
    <Style x:Key="TextBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Круглая кнопка: знак владения навыком, шаг уровня заклинания, стрелка.
      Размер берётся из SZ.RoundBtn, чтобы лист персонажа мог уменьшать её
      вместе с остальными строками; у остальных вкладок работает значение
      по умолчанию из этого словаря.
    -->
    <Style x:Key="RoundBtn" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource SZ.RoundBtn}"/>
        <Setter Property="Height" Value="{DynamicResource SZ.RoundBtn}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
        <!-- Фон и рамка берутся из свойств кнопки: по ним видно ступень
             владения навыком — у экспертизы рамка золотая -->
        <Setter Property="Background" Value="{StaticResource B.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Поле поиска: лупа, скруглённая рамка и подсказка, пока поле пустое
      и не в фокусе.

      Подсказка берётся из Tag самой строки поиска, поэтому стиль один на всё
      приложение: раньше он был скопирован в пять вкладок, и текст подсказки
      был зашит внутрь каждой копии.

      ВАЖНО: это стиль именно поиска. Для обычного поля ввода он не годится —
      в пустом поле появилась бы лупа и надпись «поиск» (так и было в редакторе
      предмета). Обычные поля — TextField и AreaField выше.
    -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.Slate}"/>
        <Setter Property="Padding" Value="30,7,10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <helpers:IconView Kind="search" IconSize="15" IconBrush="{StaticResource B.Mute}"
                                              VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource B.Mute}"
                                       Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Выпадающие списки инструментов ДМа.

      Стиль лежит в общих токенах, потому что бестиарий и трекер собирают
      поля кодом: у них нет своей разметки, а стандартный ComboBox в тёмной
      теме выглядит белым пятном и выбивается из окна.
    -->
    <Style x:Key="DmComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Arcane}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="DmComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
        <Setter Property="Background" Value="{StaticResource B.Slate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DmComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <!--
                          Кнопка раскрытия обязательна: список открывает именно она.
                          Без ToggleButton ComboBox выглядит рабочим, но по нажатию
                          не раскрывается — на этом спотыкались и здесь, и в форме предмета.
                        -->
                        <ToggleButton x:Name="toggleButton" Focusable="False" ClickMode="Press"
                                      Cursor="Hand" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Content обязателен: без него ContentPresenter берёт
                                 свойство Content у ComboBox (там пусто), и выбранное
                                 значение в закрытом списке не видно -->
                            <ContentPresenter x:Name="contentSite" Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <!-- Поле для списка с вводом: без PART_EditableTextBox
                                 ComboBox молча теряет возможность печатать -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource B.Accent}"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"/>
                            <!-- Стрелка списка. Размер 16 и цвет текста: при 10 и
                                 B.Mute значок читался как случайная точка у правого края -->
                            <helpers:IconView Grid.Column="1" Kind="caret" IconSize="16" Filled="True"
                                              IconBrush="{StaticResource B.Ink}" IsHitTestVisible="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               StaysOpen="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource B.Slate}"
                                    BorderBrush="{StaticResource B.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,2,0,0"
                                    Padding="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="250">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="contentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


