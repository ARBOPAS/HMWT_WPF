                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,7,28,7" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentDim}" BorderThickness="1"
                        CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,4,0,0">
