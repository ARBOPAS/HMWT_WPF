<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ═══ ПАЛИТРА: СВЕТЛАЯ ═══

      Тот же арканично-фэнтезийный стиль, но светлый: тёплый пергамент вместо
      почти чёрного фона, глубокий индиго вместо кремового текста, золото и
      фиолет как акценты.

      Ключи ровно те же, что в Palette.Dark.xaml, поэтому переключение темы —
      это подмена одного словаря. Ни одно значение здесь не является «на глаз»:
      акценты подобраны так, чтобы читаться на светлом фоне (золото взято
      темнее тёмного варианта, иначе мелкий текст на пергаменте выцветает).

        C.Void / C.Slate / C.Panel / C.PanelHi — фоны от страницы к карточке
        C.Line                                 — разделители и рамки
        C.Ink / C.Mute                         — основной и приглушённый текст
        C.Gold / C.GoldSoft                    — акцент и его мягкий вариант
        C.Arcane / C.Frost / C.Danger / C.Ok / C.Enchant — смысловые цвета
    -->

    <!-- Фоны: пергамент -->
    <Color x:Key="C.Void">#E9E3D5</Color>
    <Color x:Key="C.VoidMid">#F3EEE4</Color>
    <Color x:Key="C.VoidDeep">#DED6C4</Color>
    <Color x:Key="C.Slate">#F7F3EA</Color>
    <Color x:Key="C.Panel">#FCFAF5</Color>
    <Color x:Key="C.PanelHi">#EDE6D6</Color>

    <!-- Рамки -->
    <Color x:Key="C.Line">#D3C8B0</Color>

    <!-- Текст: глубокий индиго, а не чёрный — так сохраняется «магия» -->
    <Color x:Key="C.Ink">#2B2438</Color>
    <Color x:Key="C.Mute">#6E6483</Color>

    <!-- Акценты -->
    <Color x:Key="C.Gold">#9A6F10</Color>
    <Color x:Key="C.GoldSoft">#C9A659</Color>
    <Color x:Key="C.Arcane">#6D4FB0</Color>
    <Color x:Key="C.Frost">#17786F</Color>
    <Color x:Key="C.Danger">#A63A33</Color>
    <Color x:Key="C.Ok">#3D8B52</Color>
    <Color x:Key="C.Enchant">#A63A78</Color>
    <!-- Подпись на золотой заливке: золото на свету тёмное, текст — светлый -->
    <Color x:Key="C.OnGold">#FDF6E3</Color>
    <!-- Подложка под картинку предмета: на свету это тёплый нейтральный тон -->
    <Color x:Key="C.PhotoBack">#E4DCCB</Color>
    <!-- Текст на цветных заливках: заливки на свету темнее, текст светлый -->
    <Color x:Key="C.OnAccent">#F2FBF8</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="B.Void" Color="{StaticResource C.Void}"/>
    <SolidColorBrush x:Key="B.Slate" Color="{StaticResource C.Slate}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.PanelHi" Color="{StaticResource C.PanelHi}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}"/>
    <SolidColorBrush x:Key="B.Mute" Color="{StaticResource C.Mute}"/>
    <SolidColorBrush x:Key="B.Gold" Color="{StaticResource C.Gold}"/>
    <SolidColorBrush x:Key="B.GoldSoft" Color="{StaticResource C.GoldSoft}"/>
    <SolidColorBrush x:Key="B.Arcane" Color="{StaticResource C.Arcane}"/>
    <SolidColorBrush x:Key="B.Frost" Color="{StaticResource C.Frost}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="B.Enchant" Color="{StaticResource C.Enchant}"/>
    <SolidColorBrush x:Key="B.OnGold" Color="{StaticResource C.OnGold}"/>
    <SolidColorBrush x:Key="B.PhotoBack" Color="{StaticResource C.PhotoBack}"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}"/>

    <!-- Градиенты собираются из цветов палитры: фон и золотая кромка -->
    <LinearGradientBrush x:Key="B.Backdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Void}" Offset="0"/>
        <GradientStop Color="{StaticResource C.VoidMid}" Offset="0.55"/>
        <GradientStop Color="{StaticResource C.VoidDeep}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.GoldEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Gold}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Arcane}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Шрифты те же: тема меняет цвет, а не начертание -->
    <FontFamily x:Key="F.Display">Cinzel, Cinzel Decorative, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI, Calibri</FontFamily>
</ResourceDictionary>
