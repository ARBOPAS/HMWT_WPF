<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ═══ ПАЛИТРА: ТЁМНАЯ — «ГРИМУАР» ═══

      Тёплый тёмный стол: графит с фиолетовым подтоном, латунный акцент,
      кремовый текст. Это тема книги, лежащей в свете свечи: фон не синий,
      а тёплый, акцент не бирюзовый, а латунный.

      Светлая пара лежит в Palette.Light.xaml и содержит ровно те же ключи:
      переключение темы — это подмена одного словаря.

        C.Void / C.Slate / C.Panel / C.PanelHi — фоны от страницы к карточке
        C.Line                                 — разделители и рамки
        C.Ink / C.Mute                         — основной и приглушённый текст
        C.Accent / C.AccentDim                 — акцент и его мягкий вариант
        C.Arcane / C.Frost / C.Danger / C.Ok / C.Enchant — смысловые цвета
    -->

    <!-- Фоны: от почти чёрного к приподнятым панелям -->
    <Color x:Key="C.Void">#14121A</Color>
    <Color x:Key="C.VoidMid">#201B28</Color>
    <Color x:Key="C.VoidDeep">#0D0B12</Color>
    <!-- Поле ввода, строка списка -->
    <Color x:Key="C.Slate">#221E2C</Color>
    <!-- Панель -->
    <Color x:Key="C.Panel">#1C1924</Color>
    <!-- Панель под курсором, приподнятая карточка -->
    <Color x:Key="C.PanelHi">#282334</Color>

    <!-- Рамки: тёплый графит, без синевы -->
    <Color x:Key="C.Line">#3E3548</Color>

    <!-- Текст: кремовая бумага -->
    <Color x:Key="C.Ink">#EDE6D6</Color>
    <Color x:Key="C.Mute">#9C94A8</Color>

    <!-- Акцент: латунь -->
    <Color x:Key="C.Accent">#D9A94E</Color>
    <Color x:Key="C.AccentDim">#7C5B24</Color>
    <Color x:Key="C.OnAccent">#1A1206</Color>

    <!-- Смысловые цвета -->
    <Color x:Key="C.Arcane">#8B76C4</Color>
    <Color x:Key="C.Frost">#63C6D8</Color>
    <Color x:Key="C.Danger">#D06A5E</Color>
    <Color x:Key="C.Ok">#79C08E</Color>
    <Color x:Key="C.Enchant">#CE7FB0</Color>

    <!-- Подложка под картинку предмета -->
    <Color x:Key="C.PhotoBack">#191521</Color>
    <!-- Текст на цветных заливках -->
    <Color x:Key="C.OnFill">#1A1206</Color>
    <!-- Затемнение под всплывающими окнами -->
    <Color x:Key="C.Scrim">#CC0D0B12</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="B.Void" Color="{StaticResource C.Void}"/>
    <SolidColorBrush x:Key="B.Slate" Color="{StaticResource C.Slate}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.PanelHi" Color="{StaticResource C.PanelHi}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}"/>
    <SolidColorBrush x:Key="B.Mute" Color="{StaticResource C.Mute}"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentDim" Color="{StaticResource C.AccentDim}"/>
    <SolidColorBrush x:Key="B.Arcane" Color="{StaticResource C.Arcane}"/>
    <SolidColorBrush x:Key="B.Frost" Color="{StaticResource C.Frost}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="B.Enchant" Color="{StaticResource C.Enchant}"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}"/>
    <SolidColorBrush x:Key="B.OnFill" Color="{StaticResource C.OnFill}"/>
    <SolidColorBrush x:Key="B.PhotoBack" Color="{StaticResource C.PhotoBack}"/>
    <SolidColorBrush x:Key="B.Scrim" Color="{StaticResource C.Scrim}"/>
    <SolidColorBrush x:Key="B.AccentFaint" Color="{StaticResource C.Accent}" Opacity="0.13"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.Accent}" Opacity="0.22"/>

    <!-- Градиенты собираются из цветов палитры: фон и акцентная кромка -->
    <LinearGradientBrush x:Key="B.Backdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Void}" Offset="0"/>
        <GradientStop Color="{StaticResource C.VoidMid}" Offset="0.55"/>
        <GradientStop Color="{StaticResource C.VoidDeep}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.AccentEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Arcane}" Offset="1"/>
    </LinearGradientBrush>

    <!--
      Шрифты те же, что в светлой: тема меняет цвет, а не начертание.
      Constantia стоит сразу за Cinzel — в Windows его нет, и без подстраховки
      заголовки молча становились системными.
    -->
    <FontFamily x:Key="F.Display">Cinzel, Constantia, Cambria, Georgia, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI, Calibri</FontFamily>
</ResourceDictionary>
