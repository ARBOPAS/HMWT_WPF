<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ═══ ПАЛИТРА: ТЁМНАЯ (по умолчанию) ═══

      Здесь только цвета и шрифты — то, что меняется вместе с темой.
      Стили лежат отдельно, в DesignTokens.xaml, и подключаются ПОСЛЕ палитры:
      они подставляют цвета через StaticResource в момент загрузки, поэтому
      палитра обязана быть уже подключена.

      Светлая пара лежит в Palette.Light.xaml и содержит ровно те же ключи.
    -->

    <!-- Цвета -->
    <Color x:Key="C.Void">#0C0C12</Color>
    <!-- Середина и конец градиента фона: оттенки основного тона -->
    <Color x:Key="C.VoidMid">#13111D</Color>
    <Color x:Key="C.VoidDeep">#0A0A10</Color>
    <Color x:Key="C.Slate">#15151F</Color>
    <Color x:Key="C.Panel">#1B1A26</Color>
    <Color x:Key="C.PanelHi">#232132</Color>
    <Color x:Key="C.Line">#322E44</Color>
    <Color x:Key="C.Ink">#ECE4D0</Color>
    <Color x:Key="C.Mute">#8B859C</Color>
    <Color x:Key="C.Gold">#E0AE4E</Color>
    <Color x:Key="C.GoldSoft">#7A5E26</Color>
    <Color x:Key="C.Arcane">#9A7BD6</Color>
    <Color x:Key="C.Frost">#4FB6AC</Color>
    <Color x:Key="C.Danger">#C0564F</Color>
    <Color x:Key="C.Ok">#5BB974</Color>
    <Color x:Key="C.Enchant">#C0568F</Color>
    <!-- Текст и значки на золотой заливке: на свету золото темнее, поэтому
         подпись на нём должна быть светлой -->
    <Color x:Key="C.OnGold">#1A1206</Color>
    <!-- Подложка под картинку предмета, пока фото нет -->
    <Color x:Key="C.PhotoBack">#2A2438</Color>
    <!-- Текст и значки на цветных заливках «успех» и «мороз» -->
    <Color x:Key="C.OnAccent">#06201D</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="B.Void" Color="{StaticResource C.Void}"/>
    <SolidColorBrush x:Key="B.Slate" Color="{StaticResource C.Slate}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.PanelHi" Color="{StaticResource C.PanelHi}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}"/>
    <SolidColorBrush x:Key="B.Mute" Color="{StaticResource C.Mute}"/>
    <SolidColorBrush x:Key="B.Gold" Color="{StaticResource C.Gold}"/>
    <SolidColorBrush x:Key="B.GoldSoft" Color="{StaticResource C.GoldSoft}"/>
    <SolidColorBrush x:Key="B.Arcane" Color="{StaticResource C.Arcane}"/>
    <SolidColorBrush x:Key="B.Frost" Color="{StaticResource C.Frost}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="B.Enchant" Color="{StaticResource C.Enchant}"/>
    <SolidColorBrush x:Key="B.OnGold" Color="{StaticResource C.OnGold}"/>
    <SolidColorBrush x:Key="B.PhotoBack" Color="{StaticResource C.PhotoBack}"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}"/>

    <!--
      Фон окна и золотая кромка — градиентами.

      Раньше эти два ключа описывались ещё и в семи окнах/вкладках сразу, причём
      градиентами, а здесь лежали плоскими. Из-за локального переопределения
      фон в разных вкладках отличался, а светлая тема на них не действовала:
      стопы градиента были записаны конкретными тёмными значениями.

      Теперь определение одно на всё приложение и собирается из цветов палитры,
      поэтому смена палитры меняет и градиенты.
    -->
    <LinearGradientBrush x:Key="B.Backdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Void}" Offset="0"/>
        <GradientStop Color="{StaticResource C.VoidMid}" Offset="0.55"/>
        <GradientStop Color="{StaticResource C.VoidDeep}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.GoldEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Gold}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Arcane}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Шрифты -->
    <FontFamily x:Key="F.Display">Cinzel, Cinzel Decorative, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI, Calibri</FontFamily>
</ResourceDictionary>
