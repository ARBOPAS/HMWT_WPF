<UserControl x:Class="HMWT_MUI.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:HMWT_MUI.Controls"
             xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- ЦВЕТА -->

        <!-- КИСТИ -->

        <!-- ГРАДИЕНТЫ -->

        <!-- ШРИФТЫ -->
        <FontFamily x:Key="F.Display">Segoe UI Semibold, Segoe UI, Calibri</FontFamily>

        <!-- КОНВЕРТЕРЫ -->
        <helpers:TreeIndentConverter x:Key="TreeIndent" Step="12" MaxIndent="72"/>

        <!-- СТИЛИ -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Padding" Value="30,7,10,7"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <helpers:IconView Kind="search" IconSize="15" IconBrush="{StaticResource B.Mute}" 
                                           Margin="11,0,0,0" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="поиск…" Foreground="{StaticResource B.Mute}" 
                                           Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource B.Frost}"/>
        </Style>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Frost}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Frost}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт дерева: заголовок + кнопка удаления (видна при наведении) -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Margin" Value="{Binding Converter={StaticResource TreeIndent}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Вертикальные направляющие уровня, как в Obsidian:
                                     по одной линии на каждый уровень вложенности.
                                     Строятся кодом, потому что количество уровней заранее
                                     неизвестно, а так иерархия читается сразу -->
                                <ItemsControl x:Name="Guides" Grid.Column="0"
                                              ItemsSource="{Binding GuideDepths}"
                                              VerticalAlignment="Stretch" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="11" BorderBrush="{StaticResource B.Line}"
                                                    BorderThickness="1,0,0,0" Opacity="0.55"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="bd" Grid.Column="1" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="2,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <helpers:IconView x:Name="Expander" Kind="arrowRight" IconSize="12" Margin="2,0,5,0"
                                                   VerticalAlignment="Center" IconBrush="{StaticResource B.Mute}"/>
                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" 
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Button x:Name="DeleteBtn" Grid.Column="2" Width="20" Height="20" 
                                                FontSize="11" Visibility="Hidden" Tag="{Binding}"
                                                ToolTip="Удалить"
                                                Click="DeleteItem_Click"
                                                Style="{StaticResource ToolbarBtn}"><helpers:IconView Kind="close" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center"/></Button>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Expander" Property="Kind" Value="arrowDown"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                                <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C2940"/>
                            </Trigger>
                            <!-- У заметки стрелки нет: остаётся пустое место той же ширины,
                                 чтобы названия на одном уровне выравнивались -->
                            <DataTrigger Binding="{Binding IsGroup}" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Шаблон дерева заметок.

          Нужен ради одной вещи: у TreeView своя внутренняя полоса прокрутки, и
          свойство ScrollViewer.HorizontalScrollBarVisibility на сам TreeView до
          неё не доходит. Из-за этого внизу висела горизонтальная полоса, которая
          при перетаскивании дёргалась и вела себя непредсказуемо.
          Здесь внутренний прокрутчик описан явно, и горизонтальная полоса выключена.
        -->
        <Style x:Key="NotesTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контекстное меню дерева -->
        <ContextMenu x:Key="TreeMenu">
            <MenuItem x:Name="MenuOpen" Header="Открыть" Click="MenuOpen_Click"/>
            <MenuItem x:Name="MenuRename" Header="Переименовать…" Click="MenuRename_Click"/>
            <MenuItem x:Name="MenuNewSub" Header="Новая подгруппа…" Click="MenuNewSub_Click"/>
            <MenuItem x:Name="MenuNewNote" Header="Новая заметка здесь…" Click="MenuNewNote_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuExport" Header="Экспорт в Markdown…" Click="MenuExportNote_Click"/>
            <MenuItem x:Name="MenuAttach" Header="Прикрепить файл…" Click="MenuAttach_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuDelete" Header="Удалить" Click="MenuDelete_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <!-- КОРНЕВОЙ GRID -->
    <Grid Background="{StaticResource B.Backdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: ДЕРЕВО ЗАМЕТОК -->
        <Border Grid.Column="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ЗАГОЛОВОК -->
                <Border Grid.Row="0" Padding="15,12" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Заметки" FontFamily="{StaticResource F.Display}" FontSize="18" 
                               FontWeight="Bold" Foreground="{StaticResource B.Frost}"/>
                </Border>

                <!-- ПОИСК И КНОПКИ -->
                <StackPanel Grid.Row="1" Margin="10,10,10,5">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ActionBtn}" Margin="0,0,5,0" Click="CreateGroup_Click" ToolTip="Создать группу (или подгруппу в выбранной группе)"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="15" IconBrush="{StaticResource B.Void}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Группа" VerticalAlignment="Center"/></StackPanel></Button>

                        <Button Style="{StaticResource ActionBtn}" Click="CreateNote_Click" ToolTip="Создать заметку в выбранной группе"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="15" IconBrush="{StaticResource B.Void}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Заметка" VerticalAlignment="Center"/></StackPanel></Button>

                        <Button Content="⤢" Style="{StaticResource ToolbarBtn}" Margin="5,0,0,0"
                                Click="ExpandAll_Click" ToolTip="Развернуть/свернуть всё"/>
                    </StackPanel>
                </StackPanel>

                <!-- ДЕРЕВО.
                     Горизонтальную прокрутку выключаем: полоса внизу дёргалась
                     при перетаскивании и вела себя непредсказуемо. Длинные
                     названия вместо этого обрезаются с подсказкой. -->
                <TreeView x:Name="NotesTree" Grid.Row="2" Margin="5,5,5,5" 
                          Style="{StaticResource NotesTreeStyle}"
                          AllowDrop="True"
                          ItemContainerStyle="{StaticResource TreeItemStyle}"
                          ContextMenuOpening="NotesTree_ContextMenuOpening"
                          SelectedItemChanged="NotesTree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="NotesTree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="NotesTree_PreviewMouseMove"
                          DragOver="NotesTree_DragOver"
                          Drop="NotesTree_Drop">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayTitle}" Margin="3,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                <Setter Property="ToolTip" Value="Есть вложения"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- НИЖНЯЯ ПАНЕЛЬ -->
                <Border Grid.Row="3" Padding="10,8" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TreeInfoText" Text="" FontFamily="{StaticResource F.Body}"
                                   FontSize="11" Foreground="{StaticResource B.Mute}" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="{StaticResource F.Body}" FontSize="10" Foreground="{StaticResource B.Mute}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Перетаскивайте заметки и группы, чтобы менять порядок. ПКМ — меню."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: РЕДАКТОР -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК ЗАМЕТКИ.
                 Раньше это было поле вообще без рамки: заголовок визуально сливался
                 с фоном, и было не понять, куда нажимать, чтобы его изменить.
                 Теперь у поля своя рамка, при наведении она подсвечивается,
                 а при фокусе становится золотой — как у остальных полей ввода. -->
            <Border Grid.Row="0" Margin="15,15,15,10" CornerRadius="8" Background="{StaticResource B.Slate}"
                    BorderBrush="{StaticResource B.Line}" BorderThickness="1" Padding="14,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NoteTitleBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBox x:Name="NoteTitleBox"
                             FontFamily="{StaticResource F.Display}" FontSize="22" FontWeight="Bold"
                             Foreground="{StaticResource B.Ink}" Background="Transparent" BorderThickness="0"
                             CaretBrush="{StaticResource B.Gold}"
                             TextChanged="NoteTitle_TextChanged"/>
                    <TextBlock x:Name="TitlePlaceholder" Text="Название заметки" IsHitTestVisible="False"
                               FontFamily="{StaticResource F.Display}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource B.Mute}" Opacity="0.55" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ТУЛБАР -->
            <Border Grid.Row="1" Background="{StaticResource B.PanelHi}" Padding="10,5" 
                    BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                <WrapPanel x:Name="EditorToolbar"/>
            </Border>

            <!-- НАТИВНЫЙ РЕДАКТОР MARKDOWN -->
            <Border Grid.Row="2" Margin="15,10,15,10" Background="{StaticResource B.Slate}" 
                    BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <controls:MarkdownEditor x:Name="Editor"/>

                    <!-- Пустое состояние. Раньше здесь была одна серая строчка мелким
                         шрифтом, и когда заметка не выбрана, область выглядела просто
                         пустой и сломанной. Теперь это заметный блок с иконкой,
                         заголовком и подсказками, что делать. -->
                    <Border x:Name="EmptyStatePanel" Background="{StaticResource B.Slate}"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                            <helpers:IconView Kind="feather" IconSize="54" IconBrush="{StaticResource B.Gold}" Opacity="0.85"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateTitle" Text="Заметка не выбрана"
                                       FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource B.Ink}" HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="EmptyStateHint" TextWrapping="Wrap" TextAlignment="Center"
                                       FontFamily="{StaticResource F.Body}" FontSize="13.5" LineHeight="20"
                                       Foreground="{StaticResource B.Mute}" Margin="0,10,0,0"
                                       Text="Выберите заметку в списке слева или создайте новую кнопкой «+ Заметка».&#10;Заголовок и текст сохраняются автоматически."/>
                            <Border Background="{StaticResource B.PanelHi}" CornerRadius="6" Padding="12,9" Margin="0,16,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource F.Body}" FontSize="12" TextAlignment="Center"
                                           Foreground="{StaticResource B.Mute}"
                                           Text="Подсказка: **жирный**, *курсив*, # заголовок, - список, [текст](ссылка)"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- СТАТУС-БАР -->
            <Border Grid.Row="3" Background="{StaticResource B.PanelHi}" Padding="15,8" 
                    BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Готово" FontFamily="{StaticResource F.Body}" 
                               FontSize="12" Foreground="{StaticResource B.Mute}"/>
                    <TextBlock x:Name="WordCountText" Text="" FontFamily="{StaticResource F.Body}"
                               FontSize="12" Foreground="{StaticResource B.Mute}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
