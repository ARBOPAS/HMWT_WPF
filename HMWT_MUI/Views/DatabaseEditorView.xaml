<UserControl x:Class="HMWT_MUI.Views.DatabaseEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
             Background="Transparent"
             FontFamily="Segoe UI">

    <!-- Правка базы напрямую: на свой страх и риск.
         Стили описаны здесь, потому что стили чужого окна виду недоступны;
         цвета и шрифты берём из общей палитры (DesignTokens) -->
    <UserControl.Resources>
        <Style x:Key="DbHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="DbHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DbWarn" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DbBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource B.PanelHi}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4,12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="DbBtnAccent" TargetType="Button" BasedOn="{StaticResource DbBtn}">
            <Setter Property="Background" Value="{StaticResource B.Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Void}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DbBtnDanger" TargetType="Button" BasedOn="{StaticResource DbBtn}">
            <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
        </Style>
        <!-- Заголовки колонок: в светлой теме системный стиль даёт светлый текст
             на светлом фоне, поэтому цвета задаём явно -->
        <Style x:Key="DbGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DbGrid" TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DbGridHeader}"/>
            <Setter Property="Background" Value="{StaticResource B.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource B.Panel}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource B.PanelHi}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Слева — таблицы базы -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="ТАБЛИЦЫ БАЗЫ" Style="{StaticResource DbHeader}" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DbHint}" Margin="0,8,0,0"
                       Text="Это рабочие таблицы программы: персонажи, инвентарь, заклинания, справочники. Правьте с умом — отменить изменение не получится."/>
            <ListBox x:Name="lstTables" Background="{StaticResource B.Panel}" Foreground="{StaticResource B.Ink}"
                     BorderBrush="{StaticResource B.Line}" BorderThickness="1" FontSize="12"
                     SelectionChanged="Tables_SelectionChanged"/>
        </DockPanel>

        <!-- Справа — содержимое таблицы -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DbWarn}" Margin="0,0,0,8"
                       Text="ПРАВКА БАЗЫ — НА СВОЙ СТРАХ И РИСК. Перед изменениями сделайте копию кнопкой «Бэкап базы»."/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="btnReload" Content="Обновить" Style="{StaticResource DbBtn}"/>
                <Button x:Name="btnSave" Content="Сохранить" Style="{StaticResource DbBtnAccent}"/>
                <Button x:Name="btnAddRow" Content="Добавить строку" Style="{StaticResource DbBtn}"/>
                <Button x:Name="btnDeleteRow" Content="Удалить строку" Style="{StaticResource DbBtnDanger}"/>
                <Button x:Name="btnBackup" Content="Бэкап базы" Style="{StaticResource DbBtn}"/>
                <Button x:Name="btnRestore" Content="Восстановить из бэкапа" Style="{StaticResource DbBtn}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" x:Name="txtStatus" Style="{StaticResource DbHint}" Margin="0,8,0,0"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="txtWhere" Style="{StaticResource DbHint}" Margin="0,8,0,0"/>

            <DataGrid x:Name="gridTable" Style="{StaticResource DbGrid}"
                      AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeColumns="True" CanUserSortColumns="False"
                      HeadersVisibility="All" GridLinesVisibility="All" SelectionUnit="Cell"/>
        </DockPanel>
    </Grid>
</UserControl>
