<UserControl x:Class="HMWT_MUI.Views.CharacterInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <!-- ПАЛИТРА -->

        <!--
          ФОН КАРТОЧЕК ХАРАКТЕРИСТИК

          На вкладке есть декоративная руна и два цветных пятна по углам. На плотной
          заливке карточки сливались с фоном, а просвечивающая руна мешала читать
          значения характеристик. Теперь у карточек полупрозрачный фон из кистей
          темы (B.PanelHi сверху, B.Slate — строки внутри), чуть светлее фона
          вкладки: карточка видна как карточка, руна сквозь неё почти не читается,
          а текст остаётся контрастным.
        -->
        <SolidColorBrush x:Key="B.AbilityCard" Color="{StaticResource C.PanelHi}" Opacity="0.92"/>
        <SolidColorBrush x:Key="B.AbilityRow" Color="{StaticResource C.Slate}" Opacity="0.88"/>

        <!-- ==========================================================
             АДАПТИВНЫЕ РАЗМЕРЫ (дефолт = Normal; меняются из code-behind)
             ========================================================== -->
        <sys:Double x:Key="FS.AbilityTitle">13</sys:Double>
        <sys:Double x:Key="FS.AbilityScore">36</sys:Double>
        <sys:Double x:Key="FS.AbilityMod">16</sys:Double>
        <sys:Double x:Key="FS.RowText">12</sys:Double>
        <sys:Double x:Key="FS.RowValue">13</sys:Double>
        <sys:Double x:Key="FS.SaveText">13</sys:Double>
        <sys:Double x:Key="FS.ButtonText">12</sys:Double>
        <sys:Double x:Key="FS.TabText">13</sys:Double>
        <sys:Double x:Key="SZ.RoundBtn">28</sys:Double>
        <sys:Double x:Key="SZ.DiceBtn">28</sys:Double>
        <sys:Double x:Key="SZ.ActionBtnHeight">32</sys:Double>
        <Thickness x:Key="TH.AbilityCardPadding">10</Thickness>
        <Thickness x:Key="TH.SkillRowPadding">8,6</Thickness>

        <!-- СТИЛИ (размеры берутся из адаптивных ключей) -->

       

        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource SZ.RoundBtn}"/>
            <Setter Property="Height" Value="{DynamicResource SZ.RoundBtn}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MagicBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Gold}" BorderBrush="{StaticResource B.GoldEdge}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Padding" Value="30,7,10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <helpers:IconView Kind="search" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="поиск…" Foreground="{StaticResource B.Mute}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiceBtn" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource SZ.DiceBtn}"/>
            <Setter Property="Height" Value="{DynamicResource SZ.DiceBtn}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="14">
                            <!-- Оба выравнивания обязательны: без HorizontalAlignment
                                 значок растягивается на всю кнопку и рисуется от её
                                 левого края — кубик уезжал вбок из кружка -->
                            <helpers:IconView Kind="dice" IconSize="14" IconBrush="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckBtn" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource SZ.ActionBtnHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS.ButtonText}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <helpers:IconView Kind="dice" IconSize="13" IconBrush="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource SZ.ActionBtnHeight}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS.ButtonText}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <helpers:IconView Kind="shield" IconSize="15" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="FontSize" Value="{DynamicResource FS.TabText}"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Gold}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextField" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AreaField" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" TextElement.FontFamily="{StaticResource F.Body}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- AMBIENT-ФОН -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-300,0,0" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource C.Arcane}" Offset="0"/>
                        <GradientStop Color="#009A7BD6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-250,-300" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource C.Gold}" Offset="0"/>
                        <GradientStop Color="#00E0AE4E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="✶  ᛭  ᛟ  ✶  ᛭  " FontFamily="{StaticResource F.Display}" FontSize="42"
                       Foreground="{StaticResource B.Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.05">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.03" To="0.10" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Grid>

        <!-- ШАПКА С ТАБАМИ -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="tabMainBtn" Style="{StaticResource ViewTab}" Content="ХАРАКТЕРИСТИКИ" IsChecked="True" Checked="TabMain_Checked"/>
                <RadioButton x:Name="tabPersBtn" Style="{StaticResource ViewTab}" Content="ЛИЧНОСТЬ И ПРЕДЫСТОРИЯ" Checked="TabPersonality_Checked"/>
            </StackPanel>
        </Border>

        <!-- ТАБЫ С ПРОКРУТКОЙ: на небольших экранах содержимое не режется по высоте -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
        <Grid>
        <!-- ТАБ 1: ХАРАКТЕРИСТИКИ -->
        <Grid x:Name="tabMain" Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Auto: карточки характеристик получают свою натуральную высоту,
                     иначе текст обрезался на small/medium разрешениях -->
                <RowDefinition Height="Auto" MinHeight="360"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid x:Name="AbilitiesGrid" Grid.Row="0" Columns="6" Margin="8,8,8,4">

                <!-- СИЛА -->
                <!-- СИЛА -->
                <Border Background="{StaticResource B.AbilityCard}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="{DynamicResource TH.AbilityCardPadding}" Margin="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="СИЛА" Foreground="{StaticResource B.Danger}" FontFamily="{StaticResource F.Display}" FontSize="{DynamicResource FS.AbilityTitle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource B.Line}" Margin="0,0,0,8" Opacity="0.3"/>
                        <TextBlock x:Name="txtStrScore" Text="10" FontSize="{DynamicResource FS.AbilityScore}" FontWeight="Bold" Foreground="{StaticResource B.Ink}" HorizontalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="AbilityScore_Click" Tag="СИЛА"/>
                        <TextBlock x:Name="txtStrMod" Text="+0" FontSize="{DynamicResource FS.AbilityMod}" Foreground="{StaticResource B.Frost}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Проверка" Style="{StaticResource CheckBtn}" Click="BtnStrCheck_Click"/>
                            <Button Grid.Column="2" Content="Спас" Style="{StaticResource SaveBtn}" Click="BtnStrSave_Click"/>
                        </Grid>
                        <Border Background="{StaticResource B.AbilityRow}" CornerRadius="4" Padding="{DynamicResource TH.SkillRowPadding}" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="44" HorizontalAlignment="Left" x:Name="btnSaveProfStr" Grid.Column="0" Style="{StaticResource RoundBtn}" Click="ToggleSaveProf_Click" Tag="0"/>
                                <TextBlock Grid.Column="1" Text="Спасбросок" Foreground="{StaticResource B.Mute}" FontSize="{DynamicResource FS.SaveText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtStrSaveVal" Grid.Column="2" Text="+0" Foreground="{StaticResource B.Frost}" FontSize="{DynamicResource FS.RowValue}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource B.AbilityRow}" CornerRadius="4" Padding="{DynamicResource TH.SkillRowPadding}" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="44" HorizontalAlignment="Left" x:Name="btnProfAthletics" Grid.Column="0" Style="{StaticResource RoundBtn}" Click="ToggleProficiency_Click" Tag="0"/>
                                <TextBlock Text="Атлетика" Grid.Column="1" Foreground="{StaticResource B.Ink}" FontSize="{DynamicResource FS.RowText}" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock x:Name="txtAthleticsVal" Text="+0" Grid.Column="2" Foreground="{StaticResource B.Frost}" FontSize="{DynamicResource FS.RowValue}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Grid.Column="3" Style="{StaticResource DiceBtn}" Click="BtnAthleticsRoll_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ЛОВКОСТЬ -->
                <!-- ЛОВКОСТЬ -->
                <Border Background="{StaticResource B.AbilityCard}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="{DynamicResource TH.AbilityCardPadding}" Margin="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="ЛОВКОСТЬ" Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" FontSize="{DynamicResource FS.AbilityTitle}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource B.Line}" Margin="0,0,0,8" Opacity="0.3"/>
                        <TextBlock x:Name="txtDexScore" Text="10" FontSize="{DynamicResource FS.AbilityScore}" FontWeight="Bold" Foreground="{StaticResource B.Ink}" HorizontalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="AbilityScore_Click" Tag="ЛОВКОСТЬ"/>
                        <TextBlock x:Name="txtDexMod" Text="+0" FontSize="{DynamicResource FS.AbilityMod}" Foreground="{StaticResource B.Frost}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Проверка" Style="{StaticResource CheckBtn}" Click="BtnDexCheck_Click"/>
                            <Button Grid.Column="2" Content="Спас" Style="{StaticResource SaveBtn}" Click="BtnDexSave_Click"/>
                        </Grid>
                        <Border Background="{StaticResource B.AbilityRow}" CornerRadius="4" Padding="{DynamicResource TH.SkillRowPadding}" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="44" HorizontalAlignment="Left" x:Name="btnSaveProfDex" Grid.Column="0" Style="{StaticResource RoundBtn}" Click="ToggleSaveProf_Click" Tag="0"/>
                                <TextBlock Grid.Column="1" Text="Спасбросок" Foreground="{StaticResource B.Mute}" FontSize="{DynamicResource FS.SaveText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtDexSaveVal" Grid.Column="2" Text="+0" Foreground="{StaticResource B.Frost}" FontSize="{DynamicResource FS.RowValue}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource B.AbilityRow}" CornerRadius="4" Padding="{DynamicResource TH.SkillRowPadding}" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="44" HorizontalAlignment="Left" x:Name="btnProfAcrobatics" Grid.Column="0" Style="{StaticResource RoundBtn}" Click="ToggleProficiency_Click" Tag="0"/>
                                <TextBlock Text="Акробатика" Grid.Column="1" Foreground="{StaticResource B.Ink}" FontSize="{DynamicResource FS.RowText}" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock x:Name="txtAcrobaticsVal" Text="+0" Grid.Column="2" Foreground="{StaticResource B.Frost}" FontSize="{DynamicResource FS.RowValue}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Grid.Column="3" Style="{StaticResource DiceBtn}" Click="BtnAcrobaticsRoll_Click"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource B.AbilityRow}" CornerRadius="4" Padding="{DynamicResource TH.SkillRowPadding}" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="44" HorizontalAlignment="Left" x:Name="btnProfStealth" Grid.Column="0" Style="{StaticResource RoundBtn}" Click="ToggleProficiency_Click" Tag="0"/>
                                <TextBlock Text="Скрытность" Grid.Column="1" Foreground="{StaticResource B.Ink}" FontSize="{DynamicResource FS.RowText}" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock x:Name="txtStealthVal" Text="+0" Grid.Column="2" Foreground="{StaticResource B.Frost}" FontSize="{DynamicResource FS.RowValue}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
