                 внизу оставалась большая пустая область, а сами значения приходилось
                 искать в самом низу вкладки. -->
            <Border Grid.Row="1" Background="{StaticResource B.AbilityCard}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="8,4,8,12"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <helpers:IconView Kind="eye" IconSize="16" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                    <TextBlock Text="ПАССИВНЫЕ НАВЫКИ" Foreground="{StaticResource B.Gold}" FontSize="13" FontWeight="Bold"
                               FontFamily="{StaticResource F.Display}" Margin="0,0,22,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Восприятие" Foreground="{StaticResource B.Mute}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPassivePerception" Text="10" Foreground="{StaticResource B.Frost}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,22,0"/>

                    <TextBlock Text="Проницательность" Foreground="{StaticResource B.Mute}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPassiveInsight" Text="10" Foreground="{StaticResource B.Frost}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,22,0"/>

                    <TextBlock Text="Анализ" Foreground="{StaticResource B.Mute}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPassiveInvestigation" Text="10" Foreground="{StaticResource B.Frost}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,22,0"/>

                    <TextBlock Text="Инициатива" Foreground="{StaticResource B.Mute}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtInitiative" Text="+0" Foreground="{StaticResource B.Frost}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,22,0"/>

                    <TextBlock Text="Бонус мастерства" Foreground="{StaticResource B.Mute}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtProfBonus" Text="+2" Foreground="{StaticResource B.Gold}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- НИЖНЯЯ ПАНЕЛЬ: владения и языки. Стоит сразу после пассивных навыков —
                 раньше она была отдельной полосой во всю ширину, и внизу вкладки
                 оставалась пустая область. -->
            <Border Grid.Row="2" Background="{StaticResource B.AbilityCard}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,8"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <helpers:IconView Kind="shield" IconSize="15" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                            <TextBlock Text="ВЛАДЕНИЯ" Foreground="{StaticResource B.Gold}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource F.Display}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Доспехи: категории по рулбуку. Клик по кнопке отмечает владение,
                             повторный клик снимает. Раньше это было свободное текстовое поле,
                             и владения приходилось печатать вручную -->
                        <TextBlock Grid.Row="1" Text="Доспехи" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="2" x:Name="wpArmorProf" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="3" Text="Оружие" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,6"/>
                        <WrapPanel Grid.Row="4" x:Name="wpWeaponProf" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="5" Text="Языки" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtLanguages" Grid.Row="6" Style="{StaticResource AreaField}" Tag="Languages" LostFocus="AddInfo_LostFocus" Height="52"/>

                        <!-- Своё, чего нет в списке кнопок. Хранится в тех же колонках,
                             что и раньше, поэтому старые записи не теряются -->
                        <TextBlock Grid.Row="7" Text="Другое (инструменты, экзотика)" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtArmorProfCustom" Grid.Row="8" Style="{StaticResource AreaField}" Tag="Attachments" LostFocus="AddInfo_LostFocus" Height="46"
                                 ToolTip="Всё, чего нет среди кнопок: инструменты, экзотическое оружие"/>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource B.Line}" Width="1" Margin="0,20"/>

                    <!-- Здесь раньше были пассивные навыки (переехали под характеристики).
                         Сверху — заметки о персонаже, снизу — сводка по снаряжению:
                         раньше внизу справа оставалась пустая область, и было непонятно,
                         зачем она нужна. -->
                    <Grid Grid.Column="2" Margin="24,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <helpers:IconView Kind="note" IconSize="15" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                            <TextBlock Text="ЗАМЕТКИ О ПЕРСОНАЖЕ" Foreground="{StaticResource B.Gold}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource F.Display}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="txtCharacterNotes" Grid.Row="1" Style="{StaticResource AreaField}" Tag="Notes"
                                 LostFocus="AddInfo_LostFocus" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MinHeight="140"/>

                        <!-- Сводка по снаряжению: короткая справка, которую игрок
                             иначе искал бы по вкладке инвентаря -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,8">
                            <helpers:IconView Kind="shield" IconSize="15" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                            <TextBlock Text="СНАРЯЖЕНИЕ" Foreground="{StaticResource B.Frost}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource F.Display}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="3" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Экипировано" Foreground="{StaticResource B.Mute}" FontSize="12"/>
                                    <TextBlock x:Name="txtEquippedSummary" Text="—" Foreground="{StaticResource B.Ink}" FontSize="12"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Вес инвентаря" Foreground="{StaticResource B.Mute}" FontSize="12"/>
                                    <TextBlock x:Name="txtWeightSummary" Text="—" Foreground="{StaticResource B.Ink}" FontSize="12"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Золото" Foreground="{StaticResource B.Mute}" FontSize="12"/>
                                    <TextBlock x:Name="txtGoldSummary" Text="—" Foreground="{StaticResource B.Gold}" FontSize="12"
                                               FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ТАБ 2: ЛИЧНОСТЬ -->
        <Grid x:Name="tabPersonality" Grid.Row="1" Visibility="Collapsed" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ЛИЧНОСТЬ" Foreground="{StaticResource B.Gold}" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource F.Display}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Мировоззрение" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
                    <RadioButton x:Name="align0" Style="{StaticResource ViewTab}" Content="Законно-добрый" FontSize="11" GroupName="Align" Tag="0" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align1" Style="{StaticResource ViewTab}" Content="Нейтрально-добрый" FontSize="11" GroupName="Align" Tag="1" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align2" Style="{StaticResource ViewTab}" Content="Хаотично-добрый" FontSize="11" GroupName="Align" Tag="2" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align3" Style="{StaticResource ViewTab}" Content="Законно-нейтральный" FontSize="11" GroupName="Align" Tag="3" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align4" Style="{StaticResource ViewTab}" Content="Истинно нейтральный" FontSize="11" GroupName="Align" Tag="4" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align5" Style="{StaticResource ViewTab}" Content="Хаотично-нейтральный" FontSize="11" GroupName="Align" Tag="5" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align6" Style="{StaticResource ViewTab}" Content="Законно-злой" FontSize="11" GroupName="Align" Tag="6" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align7" Style="{StaticResource ViewTab}" Content="Нейтрально-злой" FontSize="11" GroupName="Align" Tag="7" Checked="Alignment_Checked"/>
                    <RadioButton x:Name="align8" Style="{StaticResource ViewTab}" Content="Хаотично-злой" FontSize="11" GroupName="Align" Tag="8" Checked="Alignment_Checked"/>
                </UniformGrid>
                <TextBlock Grid.Row="3" Text="Предыстория" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Название предыстории можно ввести руками: тогда связь со
                         справочником подтянется сама, если такая предыстория есть -->
                    <TextBox x:Name="txtBackground" Style="{StaticResource TextField}" Tag="Background"
                             LostFocus="BackgroundText_LostFocus"
                             ToolTip="Название предыстории. Кнопка справа открывает список из книги правил"/>
                    <Button Grid.Column="1" x:Name="btnSearchBackground" Style="{StaticResource RoundBtn}"
            Click="BtnSearchBackground_Click" Margin="8,0,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <helpers:IconView Kind="search" IconSize="16" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="5" Text="Черты характера" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="6" x:Name="txtPersTraits" Style="{StaticResource AreaField}" Tag="Traits" LostFocus="AddInfo_LostFocus" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="7" Text="Идеалы" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="8" x:Name="txtIdeals" Style="{StaticResource AreaField}" Tag="Ideals" LostFocus="AddInfo_LostFocus" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="9" Text="Привязанности" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="10" x:Name="txtBonds" Style="{StaticResource AreaField}" Tag="Bonds" LostFocus="AddInfo_LostFocus" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="11" Text="Слабости" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="12" x:Name="txtFlaws" Style="{StaticResource AreaField}" Tag="Weakness" LostFocus="AddInfo_LostFocus"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ВНЕШНОСТЬ И ИСТОРИЯ" Foreground="{StaticResource B.Gold}" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource F.Display}" Margin="0,0,0,8"/>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Рост" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHeight" Style="{StaticResource TextField}" Tag="Height" LostFocus="AddInfo_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Вес" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtWeight" Style="{StaticResource TextField}" Tag="Weight" LostFocus="AddInfo_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Глаза" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEyes" Style="{StaticResource TextField}" Tag="Eyes" LostFocus="AddInfo_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Волосы" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHair" Style="{StaticResource TextField}" Tag="Hair" LostFocus="AddInfo_LostFocus"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="2" Text="История персонажа" Foreground="{StaticResource B.Mute}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Grid.Row="4" x:Name="txtBackstory" Style="{StaticResource AreaField}" Tag="Backstory" LostFocus="AddInfo_LostFocus"/>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- ОВЕРЛЕЙ: ПРЕДЫСТОРИЯ -->
        <Grid x:Name="backgroundPickerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="170">
            <Border Background="#CC06060A" MouseLeftButtonDown="BackgroundPicker_Close"/>
            <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.GoldEdge}" BorderThickness="1"
                    CornerRadius="12" Padding="20" Width="600" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ВЫБОР ПРЕДЫСТОРИИ" Foreground="{StaticResource B.Gold}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource F.Display}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBox Grid.Row="1" x:Name="txtBackgroundSearch" Style="{StaticResource SearchBox}" Width="400" HorizontalAlignment="Center" TextChanged="BackgroundSearch_TextChanged" Margin="0,0,0,16"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="backgroundListPanel"/>

                            <!-- Своя предыстория: пользователь просил дать игроку
                                 возможность создавать их самому -->
                            <Border x:Name="pnlBackgroundEditor" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Gold}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="txtBackgroundEditorTitle" Text="НОВАЯ ПРЕДЫСТОРИЯ"
                                               Foreground="{StaticResource B.Gold}" FontSize="14" FontWeight="Bold"
                                               FontFamily="{StaticResource F.Display}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Название" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtName" Style="{StaticResource TextField}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Владение навыками (два, через запятую)" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtSkills" Style="{StaticResource TextField}" Margin="0,0,0,8"
                                             ToolTip="Например: Проницательность, Религия"/>

                                    <TextBlock Text="Владение инструментами" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtTools" Style="{StaticResource TextField}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Языки" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtLanguages" Style="{StaticResource TextField}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Умение предыстории" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtFeature" Style="{StaticResource TextField}" Margin="0,0,0,8"
                                             ToolTip="Как называется умение и что оно даёт"/>

                                    <TextBlock Text="Снаряжение" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtEquipment" Style="{StaticResource TextField}" Height="54"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                                    <TextBlock Text="Описание" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="bg_txtDescription" Style="{StaticResource TextField}" Height="54"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="bg_btnCancel" Content="Отмена" Style="{StaticResource GhostBtn}"
                                                Width="110" Height="32" Margin="0,0,8,0" Click="Bg_BtnCancel_Click"/>
                                        <Button x:Name="bg_btnSave" Style="{StaticResource MagicBtn}"
                                                Width="150" Height="32" Click="Bg_BtnSave_Click"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="save" IconSize="15" IconBrush="{StaticResource B.Void}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="btnBgCreate" Style="{StaticResource GhostBtn}"
                                Height="28" Margin="0,0,8,0" Click="BtnBgCreate_Click"
                                ToolTip="Создать предысторию с нужными владениями и снаряжением"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="16" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Своя предыстория" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ: ХАРАКТЕРИСТИКА И БОНУСЫ -->
        <Grid x:Name="abilityBonusOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="180">
            <Border Background="#CC06060A" MouseLeftButtonDown="AbilityBonusOverlay_Close"/>
            <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.GoldEdge}" BorderThickness="1"
            CornerRadius="12" Padding="24" Width="520" MaxHeight="660"
            HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="txtAbilityEditorTitle" Text="ХАРАКТЕРИСТИКА" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource B.Gold}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Значение:" Foreground="{StaticResource B.Mute}" FontSize="12"/>
                                <TextBlock x:Name="txtAbilityEditorScore" Text="10" Foreground="{StaticResource B.Ink}" FontSize="12" FontWeight="Bold" Margin="6,0,14,0"/>
                                <TextBlock Text="Спасбросок:" Foreground="{StaticResource B.Mute}" FontSize="12"/>
                                <TextBlock x:Name="txtAbilityEditorSave" Text="+0" Foreground="{StaticResource B.Frost}" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource RoundBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AbilityBonusOverlay_Close_Click"><helpers:IconView Kind="close" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center"/></Button>
                    </Grid>

                    <!-- Базовое значение -->
                    <Border Grid.Row="1" Background="{StaticResource B.Slate}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="БАЗОВОЕ ЗНАЧЕНИЕ" Foreground="{StaticResource B.Mute}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtAbilityBaseValue" Style="{StaticResource TextField}" FontSize="16" FontWeight="Bold" TextAlignment="Center" LostFocus="TxtAbilityBaseValue_LostFocus"/>
                        </StackPanel>
                    </Border>

                    <!-- Бонусы -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="БОНУСЫ К ПРОВЕРКЕ" Foreground="{StaticResource B.Mute}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel x:Name="panelCheckBonuses"/>
                            <Button x:Name="btnAddCheckBonus" Style="{StaticResource GhostBtn}" HorizontalAlignment="Stretch" Margin="0,6,0,16" Click="BtnAddCheckBonus_Click"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="15" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="ДОБАВИТЬ БОНУС" VerticalAlignment="Center"/></StackPanel></Button>

                            <TextBlock Text="СПАСБРОСОК" Foreground="{StaticResource B.Mute}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Button x:Name="btnSaveProfOverlay" Style="{StaticResource GhostBtn}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="BtnSaveProfOverlay_Click"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="minus" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Нет владения" VerticalAlignment="Center"/></StackPanel></Button>
                            <StackPanel x:Name="panelSaveBonuses"/>
                            <Button x:Name="btnAddSaveBonus" Style="{StaticResource GhostBtn}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="BtnAddSaveBonus_Click"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="15" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="ДОБАВИТЬ БОНУС" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>


    </Grid>
</UserControl>
