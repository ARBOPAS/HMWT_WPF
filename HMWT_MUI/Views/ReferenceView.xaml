<UserControl x:Class="HMWT_MUI.Views.ReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!--
        Вкладка «Справка»: статьи справочника 5e SRD.

        Данные приходят из таблицы SrdReference, раздел лежит в поле category.
        Поэтому подразделы строятся из самой базы: что импортировали — то и видно,
        ничего не зашито в разметку.
    -->

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Разделы справочника -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="РАЗДЕЛЫ" Style="{StaticResource RefHeader}"
                       FontSize="13" Margin="0,0,0,8"/>
            <ListBox x:Name="lstCategories" Style="{StaticResource RefList}"
                     SelectionChanged="Categories_SelectionChanged"/>
        </DockPanel>

        <!-- Поиск и статьи выбранного раздела -->
        <DockPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Style="{StaticResource RefSearch}"
                     Margin="0,0,0,8" TextChanged="Search_TextChanged"
                     ToolTip="Поиск по названию"/>
            <TextBlock x:Name="txtCount" DockPanel.Dock="Bottom" Style="{StaticResource RefHint}"
                       Margin="0,8,0,0"/>
            <ListBox x:Name="lstEntries" Style="{StaticResource RefList}"
                     SelectionChanged="Entries_SelectionChanged"/>
        </DockPanel>

        <!-- Текст статьи -->
        <Border Grid.Column="2" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="1">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="btnEditEntry" Content="Изменить" Height="28" Margin="0,0,6,0"
                            Style="{StaticResource GhostBtn}"
                            ToolTip="Править выбранную статью"/>
                    <Button x:Name="btnNewEntry" Content="Новая статья" Height="28" Margin="0,0,6,0"
                            Style="{StaticResource GhostBtn}"
                            ToolTip="Добавить свою статью в выбранный раздел"/>
                    <Button x:Name="btnDeleteEntry" Content="Удалить" Height="28"
                            Style="{StaticResource GhostBtn}"
                            ToolTip="Убрать статью из справочника"/>
                </StackPanel>
                <TextBlock x:Name="txtTitle" DockPanel.Dock="Top" Style="{StaticResource RefHeader}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtSource" DockPanel.Dock="Bottom" Style="{StaticResource RefHint}"
                           Margin="0,12,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtBody" Foreground="{StaticResource B.Ink}"
                               FontFamily="{StaticResource F.Body}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Форма статьи: открывается кнопками «Изменить» и «Новая статья» -->
        <Border x:Name="pnlEditEntry" Grid.Column="2" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Accent}" BorderThickness="1" Visibility="Collapsed">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="СТАТЬЯ СПРАВОЧНИКА" Style="{StaticResource RefHeader}" Margin="0,0,0,10"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnRefSave" Content="Сохранить" Height="30" Margin="0,0,8,0"
                            Style="{StaticResource ActionBtn}"/>
                    <Button x:Name="btnRefCancel" Content="Отмена" Height="30"
                            Style="{StaticResource GhostBtn}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource RefHint}" Margin="0,0,0,4"/>
                    <TextBox x:Name="edRefName" Style="{StaticResource RefSearch}" Margin="0,0,0,10"/>
                    <TextBlock Text="ТЕКСТ СТАТЬИ" Style="{StaticResource RefHint}" Margin="0,0,0,4"/>
                    <TextBox x:Name="edRefBody" Height="260" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource RefSearch}" Margin="0,0,0,10"/>
                    <TextBlock Text="ИСТОЧНИК (книга)" Style="{StaticResource RefHint}" Margin="0,0,0,4"/>
                    <TextBox x:Name="edRefBook" Style="{StaticResource RefSearch}" Margin="0,0,0,10"/>
                    <TextBlock Text="ИЗДАТЕЛЬ" Style="{StaticResource RefHint}" Margin="0,0,0,4"/>
                    <TextBox x:Name="edRefPublisher" Style="{StaticResource RefSearch}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Заглушка, пока справочник не загружен -->
        <Border x:Name="pnlEmpty" Grid.ColumnSpan="3" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Справочник пуст" Style="{StaticResource RefHeader}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Style="{StaticResource RefHint}" TextAlignment="Center" FontSize="13"
                           Text="Справочник наполняет сам игрок: файлы правил не входят в поставку. Импорт и настройка папки — на вкладке настроек. Любую статью можно поправить или добавить свою."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
