<UserControl x:Class="HMWT_MUI.Views.ReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!--
        Вкладка «Справка»: статьи справочника 5e SRD.

        Данные приходят из таблицы SrdReference, раздел лежит в поле category.
        Поэтому подразделы строятся из самой базы: что импортировали — то и видно,
        ничего не зашито в разметку.
    -->

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Разделы справочника -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="РАЗДЕЛЫ" Style="{StaticResource RefHeader}"
                       FontSize="13" Margin="0,0,0,8"/>
            <ListBox x:Name="lstCategories" Style="{StaticResource RefList}"
                     SelectionChanged="Categories_SelectionChanged"/>
        </DockPanel>

        <!-- Поиск и статьи выбранного раздела -->
        <DockPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Style="{StaticResource RefSearch}"
                     Margin="0,0,0,8" TextChanged="Search_TextChanged"
                     ToolTip="Поиск по названию"/>
            <TextBlock x:Name="txtCount" DockPanel.Dock="Bottom" Style="{StaticResource RefHint}"
                       Margin="0,8,0,0"/>
            <ListBox x:Name="lstEntries" Style="{StaticResource RefList}"
                     SelectionChanged="Entries_SelectionChanged"/>
        </DockPanel>

        <!-- Текст статьи -->
        <Border Grid.Column="2" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="1">
            <DockPanel Margin="16">
                <TextBlock x:Name="txtTitle" DockPanel.Dock="Top" Style="{StaticResource RefHeader}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtSource" DockPanel.Dock="Bottom" Style="{StaticResource RefHint}"
                           Margin="0,12,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtBody" Foreground="{StaticResource B.Ink}"
                               FontFamily="{StaticResource F.Body}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Заглушка, пока справочник не загружен -->
        <Border x:Name="pnlEmpty" Grid.ColumnSpan="3" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Справочник пуст" Style="{StaticResource RefHeader}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Style="{StaticResource RefHint}" TextAlignment="Center" FontSize="13"
                           Text="Открытые правила не входят в поставку: их подключает сам игрок. Скачайте базу 5e SRD (репозиторий 5e-bits/5e-srd-api), распакуйте и укажите папку с языком в разделе «Справочники SRD» на вкладке настроек — например src\2024\ru для русской базы."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
