<UserControl x:Class="HMWT_MUI.Views.SpellsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:HMWT_MUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Focusable="True"
             TextOptions.TextFormattingMode="Display"
             SnapsToDevicePixels="True">

    <UserControl.Resources>



        <!-- Чекбоксы во всей вкладке: стиль выше имеет ключ, поэтому сам не
             применялся, и обычные CheckBox выглядели системными квадратиками.
             Этот стиль без ключа действует на все чекбоксы вкладки — включая те,
             что создаются в коде (классы, теги). -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBox}"/>
    </UserControl.Resources>

    <Grid Background="Transparent">

        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520" Margin="-160,-180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource C.Arcane}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="460" Height="460" Margin="0,0,-140,-160" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource C.Accent}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- ═══════════ ОСНОВНОЙ МАКЕТ ═══════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- рейка: 4 кнопки -->
            <Border Grid.Column="0" Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                    <Button x:Name="BtnAddFromRef" ToolTip="Добавить из справочника" Cursor="Hand"
                            Margin="0,0,0,12" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="g" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="40" Height="40" Fill="{StaticResource B.Panel}" Stroke="{StaticResource B.AccentEdge}" StrokeThickness="1.5"/>
                                    <helpers:IconView Kind="plus" IconSize="18" IconBrush="{StaticResource B.Accent}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnCreateNew" ToolTip="Создать новое заклинание" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                                    <helpers:IconView Kind="edit" IconSize="16" IconBrush="{StaticResource B.Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Arcane}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnOpenTagsRail" ToolTip="Редактор тегов" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                                    <helpers:IconView Kind="tag" IconSize="15" IconBrush="{StaticResource B.Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Arcane}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- 4-я: обзор ячеек по уровням -->
                    <Button x:Name="BtnSlotsOverview" ToolTip="Обзор ячеек по уровням" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="3" Height="8"  VerticalAlignment="Bottom" Fill="{StaticResource B.Mute}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Column="1" Width="3" Height="12" VerticalAlignment="Bottom" Fill="{StaticResource B.Mute}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Grid.Column="2" Width="3" Height="5"  VerticalAlignment="Bottom" Fill="{StaticResource B.Mute}" RadiusX="1" RadiusY="1"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Frost}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- центр -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!--
                          Две строки: сверху вкладки уровней и кнопки, снизу — счётчик ячеек.

                          Счётчику нужна своя строка. В одной строке на него оставалось
                          меньше ста точек: вкладки уровней занимают 344, кнопки справа —
                          402, а сама эта колонка вдвое уже окна, потому что 300 точек
                          забирает панель описания заклинания. В узком окне на счётчик
                          не оставалось места вовсе, и кнопка восполнения уезжала за край.
                          На своей строке счётчик располагает всей шириной шапки.
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabAll" Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="ВСЕ" Tag="-1" IsChecked="True" Checked="LevelTab_Checked" ToolTip="Показать все уровни"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs"  Tag="0" Checked="LevelTab_Checked" ToolTip="Заговоры"><helpers:IconView Kind="star" IconSize="15" IconBrush="{StaticResource B.Accent}" VerticalAlignment="Center"/></RadioButton>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="I"   Tag="1" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="II"  Tag="2" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="III" Tag="3" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="IV"  Tag="4" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="V"   Tag="5" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="VI"  Tag="6" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="VII" Tag="7" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="VIII" Tag="8" Checked="LevelTab_Checked"/>
                            <RadioButton Style="{StaticResource LevelTab}" GroupName="LevelTabs" Content="IX"  Tag="9" Checked="LevelTab_Checked"/>
                        </StackPanel>

                        <!--
                          Счётчик ячеек — отдельной строкой под вкладками уровней
                          и кнопками (объяснение в определении строк выше).

                          Внутри блока:
                          • у чисел узкая ячейка и выравнивание ПО ЦЕНТРУ. Прежние
                            MinWidth 34 с выравниванием вправо давали дыру 29 точек
                            после «−» и 20 после «/» — те самые «гигантские отступы»;
                          • подпись занимает остаток ширины и при нехватке места
                            обрезается многоточием (полный текст — в подсказке),
                            а не выталкивает кнопку отдыха за границу.
                        -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MaxWidth="420" Margin="0,10,0,0"
                                Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="5,3"
                                ToolTip="Ячейки заклинаний: остаток / всего">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnSlotMinus" Grid.Column="0" Style="{StaticResource SlotStepBtn}"
                                        Margin="1,0" ToolTip="Потратить ячейку">
                                    <helpers:IconView Kind="minus" IconSize="14" VerticalAlignment="Center"
                                                      IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <TextBlock x:Name="TxtSlotsUsed" Grid.Column="1" Text="0"
                                           FontFamily="{StaticResource F.Display}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"
                                           Margin="5,0,0,0" MinWidth="30" TextAlignment="Center"
                                           ToolTip="Осталось ячеек"/>

                                <TextBlock Grid.Column="2" Text="/" FontFamily="{StaticResource F.Display}"
                                           FontSize="14" Foreground="{StaticResource B.Mute}"
                                           VerticalAlignment="Center" Margin="2,0" ToolTip="Всего ячеек"/>

                                <TextBlock x:Name="TxtSlotsTotal" Grid.Column="3" Text="0"
                                           FontFamily="{StaticResource F.Display}" FontSize="16"
                                           Foreground="{StaticResource B.Ink}" VerticalAlignment="Center"
                                           MinWidth="22" TextAlignment="Center" ToolTip="Всего ячеек"/>

                                <Button x:Name="BtnSlotPlus" Grid.Column="4" Style="{StaticResource SlotStepBtn}"
                                        Margin="4,0,1,0" ToolTip="Восполнить ячейку">
                                    <helpers:IconView Kind="plus" IconSize="14" VerticalAlignment="Center"
                                                      IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <TextBlock x:Name="TxtSlotsLabel" Grid.Column="5" Text="ячейки I уровня"
                                           FontFamily="{StaticResource F.Body}" FontSize="11"
                                           Foreground="{StaticResource B.Mute}" VerticalAlignment="Center"
                                           Margin="7,0,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                <Button x:Name="BtnRestSlots" Grid.Column="6" Style="{StaticResource SlotRestBtn}"
                                        Margin="6,0,0,0" ToolTip="Отдых: восполнить все ячейки">
                                    <helpers:IconView Kind="round" IconSize="14" VerticalAlignment="Center"
                                                      IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnTagFilter" Style="{StaticResource RoundBtn}" ToolTip="Фильтр по тегам" Margin="0,0,6,0">
                                <helpers:IconView Kind="filter" IconSize="16" Filled="True"
                                                  IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="200" Tag="поиск по всем уровням…" />
                            <ToggleButton x:Name="ToggleSettings" Style="{StaticResource IconBtn}" ToolTip="Настройки заклинаний и теги" Margin="8,0,0,0">
                                <helpers:IconView Kind="gear" IconSize="16" IconBrush="{StaticResource B.Mute}"/>
                            </ToggleButton>
                            <Button x:Name="BtnExpandFull" Style="{StaticResource RoundBtn}" ToolTip="Развернуть карточку на весь экран" Margin="6,0,0,0">
                                <helpers:IconView Kind="expand" IconSize="16"
                                                  IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>

                            <!-- Обмен своими заклинаниями и предметами с другими игроками -->
                            <Button x:Name="BtnShareExport" Style="{StaticResource RoundBtn}" Margin="6,0,0,0"
                                    Click="BtnShareExport_Click"
                                    ToolTip="Выгрузить свои заклинания и предметы в файл для другого игрока">
                                <helpers:IconView Kind="upload" IconSize="16"
                                                  IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="BtnShareImport" Style="{StaticResource RoundBtn}" Margin="6,0,0,0"
                                    Click="BtnShareImport_Click"
                                    ToolTip="Загрузить заклинания и предметы из файла, который сделал другой игрок">
                                <helpers:IconView Kind="download" IconSize="16"
                                                  IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ActiveFiltersBar" Grid.Row="1" Padding="14,8,14,4"
                        BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <WrapPanel x:Name="ActiveFiltersPanel" Orientation="Horizontal"/>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,12,8,16">
                    <StackPanel>
                        <Grid Margin="8,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionHead}" Text="ПОДГОТОВЛЕННЫЕ ЗАКЛИНАНИЯ" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtPreparedCount" Text="подготовлено 0" FontFamily="{StaticResource F.Body}" FontSize="12" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            </StackPanel>
                            <!-- Кнопка «Подготовить» убрана: режим подготовки дублировал
                                 обычное добавление заклинания и только путал -->
                        </Grid>
                        <WrapPanel x:Name="PreparedCardsStack" Orientation="Horizontal" Margin="0,4,0,0"/>
                        <Border Height="1" Background="{StaticResource B.Line}" Margin="8,14"/>
                        <TextBlock Style="{StaticResource SectionHead}" Text="ИЗВЕСТНЫЕ ЗАКЛИНАНИЯ" Margin="16,2,8,2"/>
                        <Border Background="#0AFFFFFF" CornerRadius="8" Margin="8,6,8,0" Padding="0,6">
                            <WrapPanel x:Name="KnownCardsStack" Orientation="Horizontal"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- компактный предпросмотр -->
            <Border x:Name="CompactPreview" Grid.Column="2" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Mute}" Margin="0,0,0,10"/>
                        <Border Height="150" CornerRadius="8" ClipToBounds="True" Background="{StaticResource B.PhotoBack}" Margin="0,0,0,10">
                            <Grid>
                                <Image x:Name="DescImage" Stretch="Uniform"/>
                                <Border x:Name="DescArtPlaceholder" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock x:Name="DescArtRune" Text="✶" FontFamily="{StaticResource F.Display}" FontSize="60"
                                                   Foreground="#14FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DescArtLetter" Text="?" FontFamily="{StaticResource F.Display}" FontSize="74" FontWeight="Bold"
                                                   Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="Характеристики" FontFamily="{StaticResource F.Display}" FontSize="13" Foreground="{StaticResource B.Accent}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DescLevelSchool" Text="—" Foreground="{StaticResource B.Ink}" FontSize="13" FontStyle="Italic" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Время:</Run> <Run x:Name="DescCasting" Text="—"/></TextBlock>
                        <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Дистанция:</Run> <Run x:Name="DescRange" Text="—"/></TextBlock>
                        <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Компоненты:</Run> <Run x:Name="DescComponents" Text="—"/></TextBlock>
                        <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Длительность:</Run> <Run x:Name="DescDuration" Text="—"/></TextBlock>
                        <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,10"><Run FontWeight="SemiBold">Классы:</Run> <Run x:Name="DescClasses" Text="—"/></TextBlock>
                        <TextBlock x:Name="DescName" Text="Выберите заклинание" FontFamily="{StaticResource F.Display}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource B.Ink}" Margin="0,2,0,6"/>

                        <!-- ═══ ОСТРОВОК КАСТОВАНИЯ ═══
                             Соединён с карточкой заклинания: нажатие тратит ячейку
                             нужного уровня и бросает урон. «+» поднимает уровень
                             (каждый уровень выше добавляет урон за уровень), «−»
                             появляется только после «+», чтобы нельзя было уйти
                             ниже базового уровня заклинания. -->
                        <Border x:Name="CastIsland" Visibility="Collapsed" Margin="0,0,0,10"
                                Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Arcane}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="СОТВОРИТЬ" FontFamily="{StaticResource F.Display}" FontSize="12"
                                                   FontWeight="Bold" Foreground="{StaticResource B.Arcane}"/>
                                        <TextBlock x:Name="CastSlotText" Text="ячейка —" Foreground="{StaticResource B.Mute}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- Уровень ячейки: − появляется только когда уровень поднят -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnCastLevelMinus" Content="−" Width="28" Height="28" FontSize="15"
                                                Style="{StaticResource MiniRound}" Margin="0,0,6,0" Visibility="Visible"
                                                ToolTip="Понизить уровень ячейки" Click="BtnCastLevelMinus_Click"/>
                                        <TextBlock x:Name="CastLevelText" Text="1" FontFamily="{StaticResource F.Display}"
                                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource B.Frost}"
                                                   VerticalAlignment="Center" MinWidth="22" TextAlignment="Center"
                                                   ToolTip="Уровень ячейки, которой будет сотворено заклинание"/>
                                        <Button x:Name="BtnCastLevelPlus" Content="+" Width="28" Height="28" FontSize="15"
                                                Style="{StaticResource MiniRound}" Margin="6,0,0,0"
                                                ToolTip="Сотворить уровнем выше: добавится урон или лечение за уровень"
                                                Click="BtnCastLevelPlus_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="CastFormulaText" Text="" Foreground="{StaticResource B.Frost}" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <!-- Лечение бросается отдельно от урона, поэтому
                                     решение «прибавить ли его персонажу» — тоже
                                     отдельное: целитель чаще лечит других -->
                                <CheckBox x:Name="ChkHealSelf" Content="Прибавлять лечение персонажу"
                                          Style="{StaticResource CustomCheckBox}" Margin="0,8,0,0"
                                          Checked="ChkHealSelf_Changed" Unchecked="ChkHealSelf_Changed"
                                          ToolTip="Бросок лечения прибавится к здоровью этого персонажа. Снимите галочку, если лечите другого"/>

                                <Button x:Name="BtnCastSpell" Height="36" Margin="0,10,0,0"
                                        Style="{StaticResource ActionBtn}" Click="BtnCastSpell_Click"
                                        ToolTip="Потратить ячейку и бросить урон"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="sparkle" IconSize="16" IconBrush="{StaticResource B.Arcane}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Сотворить" VerticalAlignment="Center"/></StackPanel></Button>

                                <!-- Атаки живут на одной вкладке: отсюда заклинание
                                     переносится туда, где у атаки своё попадание и история -->
                                <Button x:Name="BtnSpellToAttacks" Height="30" Margin="0,6,0,0"
                                        Style="{StaticResource ActionBtn}" Click="BtnSpellToAttacks_Click"
                                        ToolTip="Добавить заклинание на вкладку «Атаки»: там бросок попадания и урона в одном месте"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="sword" IconSize="16" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="В атаки" VerticalAlignment="Center"/></StackPanel></Button>

                                <TextBlock x:Name="CastWarnText" Foreground="{StaticResource B.Danger}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DescText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource B.Ink}" LineHeight="19" Text="Клик по карточке покажет её здесь. Двойной клик — полный редактор. Кнопка ⤢ в шапке тоже раскрывает его."/>
                        <TextBlock x:Name="DescHigher" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource B.Arcane}" LineHeight="18" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════ ПОЛНЫЙ РЕДАКТОР (35 / 30 / 35) ═══════════ -->
        <Grid x:Name="FullEditorOverlay" Panel.ZIndex="150" Visibility="Collapsed" Background="{StaticResource B.Backdrop}">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,12,0" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="10" Background="{StaticResource B.Panel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ГОТОВАЯ КАРТОЧКА" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
                            <Border x:Name="FullModifiedBadge" Grid.Column="1" Visibility="Collapsed" Margin="8,0,0,0"
                                    Background="{StaticResource B.AccentSoft}" CornerRadius="8" Padding="7,2" VerticalAlignment="Center" ToolTip="Изменено относительно справочника">
                                <TextBlock Text="изменено" FontSize="10" Foreground="{StaticResource B.Accent}"/>
                            </Border>
                            <Button x:Name="BtnCollapseFull" Grid.Column="3" Cursor="Hand" ToolTip="Свернуть" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:IconView Kind="shrink" IconSize="14" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center"/>
                                                <TextBlock Text="свернуть" FontSize="11" Foreground="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="FullLevelSchool" Text="—" Foreground="{StaticResource B.Ink}" FontSize="13" FontStyle="Italic" Margin="0,0,0,8"/>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Время накладывания:</Run> <Run x:Name="FullCasting" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Дистанция:</Run> <Run x:Name="FullRange" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Компоненты:</Run> <Run x:Name="FullComponents" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Длительность:</Run> <Run x:Name="FullDuration" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Школа:</Run> <Run x:Name="FullSchool" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,3"><Run FontWeight="SemiBold">Источник:</Run> <Run x:Name="FullSource" Text="—"/></TextBlock>
                                <TextBlock Foreground="{StaticResource B.Ink}" FontSize="13" Margin="0,0,0,12"><Run FontWeight="SemiBold">Классы:</Run> <Run x:Name="FullClasses" Text="—"/></TextBlock>
                                <TextBlock x:Name="FullName" Text="—" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource B.Ink}" Margin="0,2,0,8"/>
                                <TextBlock x:Name="FullText" TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource B.Ink}" LineHeight="20"/>
                                <TextBlock x:Name="FullHigher" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource B.Arcane}" LineHeight="19" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True" Background="{StaticResource B.PhotoBack}">
                        <Grid>
                            <!-- HoverGif: арт заклинания не разбирается заранее,
                                 гифка оживает только под курсором -->
                            <controls:HoverGif x:Name="FullImage" Stretch="Uniform"/>
                            <Border x:Name="FullArtPlaceholder" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock x:Name="FullArtRune" Text="✶" FontFamily="{StaticResource F.Display}" FontSize="120"
                                               Foreground="#12FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FullArtLetter" Text="?" FontFamily="{StaticResource F.Display}" FontSize="150" FontWeight="Bold"
                                               Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Cursor="Hand" Background="{StaticResource B.Panel}" MouseLeftButtonUp="FullImage_Click">
                        <TextBlock TextAlignment="Center" Foreground="{StaticResource B.Mute}" FontSize="11" Text="ЗАГРУЗИ СВОЙ АРТ (png / jpg / gif)&#x0a;gif проигрывается анимацией"/>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Пр." Foreground="{StaticResource B.Mute}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button x:Name="BtnFullPrev" Style="{StaticResource NavArrow}" Content="‹" ToolTip="Предыдущее"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Сл." Foreground="{StaticResource B.Mute}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button x:Name="BtnFullNext" Style="{StaticResource NavArrow}" Content="›" ToolTip="Следующее"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="10" Background="{StaticResource B.Panel}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="НАСТРОЙКА ЗАКЛИНАНИЯ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Предупреждение без упоминания справочника: игрок
                                 наполняет базу сам, и правки его же заклинания
                                 касаются только его персонажей -->
                            <Border x:Name="TxtRulebookWarning" Visibility="Collapsed" Margin="0,0,0,12"
                                    Background="{StaticResource B.AccentFaint}" BorderBrush="{StaticResource B.AccentDim}" BorderThickness="1" CornerRadius="6" Padding="9,7">
                                <TextBlock x:Name="TxtRulebookWarningText" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource B.Accent}"
                                           Text="Это заклинание уже есть у других персонажей. Правки затронут и их — карточка будет помечена как «изменено»."/>
                            </Border>

                            <TextBlock Text="Название" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdName" Style="{StaticResource TextField}" Margin="0,0,0,9"/>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="[ 1 ] Уровень" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="EdLevel" Width="110" HorizontalAlignment="Left" IsEditable="False" Style="{StaticResource EditorComboBox}">
                                        <ComboBoxItem Content="0 (Заговор)"/>
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="7"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Школа" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="EdSchool" IsEditable="True" Style="{StaticResource EditorComboBox}">
                                        <ComboBoxItem Content="Защита"/>
                                        <ComboBoxItem Content="Призыв"/>
                                        <ComboBoxItem Content="Прорицание"/>
                                        <ComboBoxItem Content="Очарование"/>
                                        <ComboBoxItem Content="Эвокация"/>
                                        <ComboBoxItem Content="Иллюзия"/>
                                        <ComboBoxItem Content="Некромантия"/>
                                        <ComboBoxItem Content="Трансмутация"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="[ 1д ] Время накладывания" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdCasting" Style="{StaticResource TextField}" Margin="0,0,0,9"/>

                            <TextBlock Text="Дистанция" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdRange" Style="{StaticResource TextField}" Margin="0,0,0,9"/>

                            <TextBlock Text="Компоненты" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <CheckBox x:Name="ChkCompV" Content="В" Foreground="{StaticResource B.Ink}" FontSize="12" Margin="0,0,12,0" ToolTip="Вербальный"/>
                                <CheckBox x:Name="ChkCompS" Content="С" Foreground="{StaticResource B.Ink}" FontSize="12" Margin="0,0,12,0" ToolTip="Соматический"/>
                                <CheckBox x:Name="ChkCompM" Content="М" Foreground="{StaticResource B.Ink}" FontSize="12" ToolTip="Материальный"/>
                            </StackPanel>

                            <TextBlock Text="[ 1:00 ] Длительность" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdDuration" Style="{StaticResource TextField}" Margin="0,0,0,9"/>

                            <TextBlock Text="Классы" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <Border Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,9">
                                <WrapPanel x:Name="ClassesPanel" Orientation="Horizontal"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ChkConcentration" Content="Концентрация" Foreground="{StaticResource B.Ink}" FontSize="12.5" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkRitual" Content="Ритуал" Foreground="{StaticResource B.Ink}" FontSize="12.5"/>
                            </StackPanel>

                            <TextBlock Text="Описание" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdDescription" Style="{StaticResource AreaField}" Height="120" Margin="0,0,0,9"/>

                            <!-- === Эффект для кастования ===
                                 В справочниках урон лежит внутри английского текста
                                 описания, поэтому игрок указывает формулу сам: она
                                 уходит в бросок при нажатии «Сотворить». -->
                            <Border Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Arcane}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="ЭФФЕКТ ПРИ СОТВОРЕНИИ" FontFamily="{StaticResource F.Display}" FontSize="11.5"
                                               FontWeight="Bold" Foreground="{StaticResource B.Arcane}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Урон на базовом уровне" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox x:Name="EdDamageFormula" Style="{StaticResource TextField}"
                                                     TextChanged="Ed_DamageField_TextChanged"
                                                     ToolTip="Например 1d4+4 — урон заклинания своего уровня. Если урона нет, оставьте пустым"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Тип урона" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdDamageType" Style="{StaticResource EditorComboBox}" IsEditable="True"
                                                      ToolTip="Список, чтобы не было опечаток"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Добавка за каждый уровень выше" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="EdPerLevelDamage" Style="{StaticResource TextField}" Width="150" HorizontalAlignment="Left"
                                             TextChanged="Ed_DamageField_TextChanged"
                                             ToolTip="Например 1d6 — столько добавится за каждый уровень выше базового"/>

                                    <!-- === Составной урон ===
                                         У одного каста бывает несколько типов урона:
                                         «2к8+6 колющим + 3к10 психическим». Кнопка добавления вносит
                                         часть со своей костью и типом, крестик убирает. Все части
                                         бросаются за одно сотворение, каждая со своей подписью. -->
                                    <StackPanel x:Name="spExtraDamage" Margin="0,8,0,0"/>
                                    <Button x:Name="btnAddDamagePart"
                                            Style="{StaticResource TextBtn}" Click="BtnAddDamagePart_Click"
                                            HorizontalAlignment="Left" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="plus" IconSize="16" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Ещё один тип урона" VerticalAlignment="Center"/></StackPanel></Button>

                                    <!-- === Лечение ===
                                         Отдельный блок, а не одно «значение»: у заклинания
                                         бывает и урон, и лечение сразу, а бывает только
                                         лечение — «Исцеляющее слово» лечит 2к4 и урона
                                         не наносит вовсе. -->
                                    <Border Background="{StaticResource B.Void}" BorderBrush="{StaticResource B.Ok}"
                                            BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ЛЕЧЕНИЕ" FontFamily="{StaticResource F.Display}" FontSize="11"
                                                       FontWeight="Bold" Foreground="{StaticResource B.Ok}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Лечение на базовом уровне" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="EdHealFormula" Style="{StaticResource TextField}"
                                                             TextChanged="Ed_DamageField_TextChanged"
                                                             ToolTip="Например 2d4 — сколько хитов возвращает заклинание. Если не лечит, оставьте пустым"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Добавка за уровень выше" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="EdHealPerLevel" Style="{StaticResource TextField}"
                                                             TextChanged="Ed_DamageField_TextChanged"
                                                             ToolTip="Например 1d4 — столько добавится к лечению за каждый уровень выше базового"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Спасбросок цели" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,10,0,3"/>
                                    <TextBox x:Name="EdSaveNote" Style="{StaticResource TextField}"
                                             TextChanged="Ed_DamageField_TextChanged"
                                             ToolTip="Например: Спас Ловкости Сл 15, половина при успехе. Показывается при сотворении"/>

                                    <!-- Живой пример: игрок сразу видит, что получится при касте выше -->
                                    <TextBlock x:Name="EdDamagePreview" Foreground="{StaticResource B.Frost}" FontSize="10.5"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Урон на базовом уровне: —"/>
                                    <TextBlock Text="Формат: 2d6, 1d8+3. Без знака «+» добавка тоже поймётся. Если урона нет — оставьте пустым, ячейка всё равно тратится."
                                               Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="На больших уровнях" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdHigher" Style="{StaticResource AreaField}" Height="70" Margin="0,0,0,9"/>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Источник" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="EdSource" Style="{StaticResource TextField}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Страница" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="EdPage" Style="{StaticResource TextField}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Материальный компонент" Foreground="{StaticResource B.Mute}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="EdMaterial" Style="{StaticResource TextField}" Margin="0,0,0,12"/>

                            <Border Height="1" Background="{StaticResource B.Line}" Margin="0,2,0,10"/>
                            <TextBlock Text="ТЕГИ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Arcane}" Margin="0,0,0,3"/>
                            <TextBlock Text="Отметь теги этого заклинания (сохранится в БД)." Foreground="{StaticResource B.Mute}" FontSize="10.5" FontStyle="Italic" Margin="0,0,0,6"/>
                            <Border MinHeight="34" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,14">
                                <WrapPanel x:Name="TagsAssignPanel" Orientation="Horizontal"/>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnCancelCreate" Grid.Column="0" Style="{StaticResource TextBtn}" Content="Отмена" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,12,0"/>
                                <Button x:Name="BtnFullSave" Grid.Column="1" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right">
                                    <TextBlock Text="Сохранить карточку" Foreground="{StaticResource B.OnAccent}" FontWeight="SemiBold" FontSize="12.5"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ ОВЕРЛЕЙ: ОБЗОР ЯЧЕЕК ПО УРОВНЯМ ═══════════ -->
        <Grid x:Name="SlotsOverviewOverlay" Panel.ZIndex="175" Visibility="Collapsed">
            <Border Background="{StaticResource B.Scrim}" MouseLeftButtonDown="SlotsOverviewBg_Click"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="66,16,0,0" Width="220"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="ЯЧЕЙКИ ПО УРОВНЯМ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Frost}" VerticalAlignment="Center" FontSize="12"/>
                        <Button x:Name="SlotsOverviewClose" Style="{StaticResource TextBtn}" HorizontalAlignment="Right"><helpers:IconView Kind="close" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center"/></Button>
                    </Grid>
                    <TextBlock Text="осталось / всего" Foreground="{StaticResource B.Mute}" FontSize="10" FontStyle="Italic" Margin="0,0,0,8"/>
                    <StackPanel x:Name="SlotsOverviewList"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ ОВЕРЛЕЙ: ФИЛЬТР ПО ТЕГАМ ═══════════ -->
        <Grid x:Name="TagFilterOverlay" Panel.ZIndex="175" Visibility="Collapsed" Background="{StaticResource B.Scrim}">
            <Border Width="Auto" MinWidth="320" MaxWidth="420" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="ФИЛЬТР ПО ТЕГАМ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Arcane}" VerticalAlignment="Center"/>
                        <Button x:Name="TagFilterClose" Style="{StaticResource TextBtn}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="close" IconSize="16" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="закрыть" VerticalAlignment="Center"/></StackPanel></Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Выбранные теги комбинируются как «И» — останутся заклинания, у которых есть все отмеченные теги."
                               Foreground="{StaticResource B.Mute}" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Grid.Row="2" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="TagFilterList" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TagFilterStatus" Foreground="{StaticResource B.Mute}" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="TagFilterClear" Grid.Column="1" Style="{StaticResource TextBtn}" Content="сбросить всё"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ ОВЕРЛЕЙ: СПРАВОЧНИК ═══════════ -->
        <Grid x:Name="SpellbookOverlay" Panel.ZIndex="170" Visibility="Collapsed" Background="{StaticResource B.Scrim}">
            <Border Width="Auto" MinWidth="380" MaxWidth="640" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="СПРАВОЧНИК ЗАКЛИНАНИЙ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
                        <Button x:Name="SbClose" Style="{StaticResource TextBtn}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="close" IconSize="16" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="закрыть" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="СПРАВОЧНИК ЗАКЛИНАНИЙ" Style="{StaticResource SectionHead}" 
               Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"
               Margin="0,0,80,0"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SbSearch" Style="{StaticResource SearchBox}" TextChanged="SbSearch_TextChanged" Tag="поиск по названию…" />
                        <ComboBox Grid.Column="2" x:Name="SbSourceFilter" Style="{StaticResource SourceBox}"
              SelectionChanged="SbSourceFilter_SelectionChanged"
              Panel.ZIndex="5"/>
                    </Grid>
                    <ListBox x:Name="SbList" Grid.Row="2" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                             Foreground="{StaticResource B.Ink}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Ink}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Meta}" Foreground="{StaticResource B.Mute}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SbStatus" Foreground="{StaticResource B.Mute}" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="SbAddSelected" Grid.Column="1" Style="{StaticResource ActionBtn}">
                            <TextBlock Text=" Добавить выбранное" Foreground="{StaticResource B.OnAccent}" FontWeight="SemiBold" FontSize="12.5"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ ОВЕРЛЕЙ: РЕДАКТОР ТЕГОВ ═══════════ -->
        <Grid x:Name="TagsOverlay" Panel.ZIndex="170" Visibility="Collapsed" Background="{StaticResource B.Scrim}">
            <Border Width="Auto" MinWidth="340" MaxWidth="460" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="РЕДАКТОР ТЕГОВ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Arcane}" VerticalAlignment="Center"/>
                        <Button x:Name="TagsClose" Style="{StaticResource TextBtn}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="close" IconSize="16" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="закрыть" VerticalAlignment="Center"/></StackPanel></Button>
                    </Grid>
                    <ListBox x:Name="TagsList" Grid.Row="1" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                             Foreground="{StaticResource B.Ink}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#339A7BD6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource B.Mute}" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TagNewName" Style="{StaticResource TextField}" Margin="0,0,8,0" ToolTip="Название нового тега"/>
                        <TextBox x:Name="TagNewCategory" Grid.Column="1" Style="{StaticResource TextField}" ToolTip="Категория (необязательно)"/>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTagDelete" Grid.Column="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" BorderBrush="{StaticResource B.Danger}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <StackPanel Orientation="Horizontal"><helpers:IconView Kind="trash" IconSize="14" IconBrush="{StaticResource B.Danger}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Удалить тег" Foreground="{StaticResource B.Danger}" FontSize="12"/></StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22C0564F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnTagAdd" Grid.Column="2" Style="{StaticResource ActionBtn}">
                            <TextBlock Text=" Создать тег" Foreground="{StaticResource B.OnAccent}" FontWeight="SemiBold" FontSize="12.5"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ ОВЕРЛЕЙ НАСТРОЕК ═══════════ -->
        <Grid x:Name="SettingsOverlay" Panel.ZIndex="200" Opacity="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleSettings}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#9906060A"/>

            <Border Width="Auto" MinWidth="420" MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <RadioButton x:Name="SetCtxSheet" Content="Выбранный лист" IsChecked="True" GroupName="SetCtx" Style="{StaticResource LevelTab}" ToolTip="Настройки текущего персонажа"/>
                        <RadioButton x:Name="SetCtxGlobal" Content="Глобально" GroupName="SetCtx" Style="{StaticResource LevelTab}" ToolTip="Дефолт для новых персонажей"/>
                    </StackPanel>
                    <TextBlock Text="«Глобально» сохраняет шаблон по умолчанию; «лист» — только этому персонажу."
                               Foreground="{StaticResource B.Mute}" FontSize="10.5" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="НАСТРОЙКА ЗАКЛИНАНИЙ" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Accent}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Доступные уровни" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center" Width="150" ToolTip="До какого уровня показывать табы"/>
                            <ComboBox x:Name="CmbMaxLevel" Width="76" SelectedIndex="0" Style="{StaticResource EditorComboBox}" ToolTip="До какого уровня показывать табы. «0-9» — все уровни">
                                <ComboBoxItem Content="0-9"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem>1</ComboBoxItem>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Заклин. характеристика" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center" Width="150"/>
                            <ComboBox x:Name="CmbSpellStat" Width="120" SelectedIndex="2" Style="{StaticResource EditorComboBox}" ToolTip="Характеристика для Сл спасброска и атаки заклинанием">
                                <ComboBoxItem Content="Интеллект"/>
                                <ComboBoxItem Content="Мудрость"/>
                                <ComboBoxItem Content="Харизма"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Ячейки по уровням (свободный режим, без привязки к уровню персонажа)"
                               Foreground="{StaticResource B.Mute}" FontSize="11" FontStyle="Italic" Margin="0,6,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="I   " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot1" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="II  " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot2" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="III " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot3" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="IV  " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot4" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="V   " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot5" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="VI  " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot6" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="VII " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot7" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="VIII" Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot8" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="IX  " Foreground="{StaticResource B.Frost}" FontFamily="{StaticResource F.Display}" Width="26"/>
                            <TextBox x:Name="Slot9" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ячейки колдуна" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center" Width="150"/>
                            <TextBox x:Name="TxtWarlockSlots" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Лимит подготовки" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center" Width="150" ToolTip="0 = не требуется"/>
                            <TextBox x:Name="TxtPreparedLimit" Style="{StaticResource NumField}" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource B.Line}" Margin="0,18,0,12"/>
                    <TextBlock Text="ФОРМУЛЫ БРОСКА" Style="{StaticResource SectionHead}" Foreground="{StaticResource B.Arcane}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Сл спасброска = 8 + бонус мастерства + мод. характеристики" Foreground="{StaticResource B.Ink}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSpellSaveDC" Text="  = —" Foreground="{StaticResource B.Accent}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Атака заклинанием = бонус мастерства + мод. характеристики" Foreground="{StaticResource B.Ink}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSpellAttack" Text="  = —" Foreground="{StaticResource B.Accent}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnOpenTagEditor" Cursor="Hand" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" BorderBrush="{StaticResource B.Arcane}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <StackPanel Orientation="Horizontal"><helpers:IconView Kind="tag" IconSize="14" IconBrush="{StaticResource B.Arcane}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Редактор тегов" Foreground="{StaticResource B.Arcane}" FontSize="12"/></StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#229A7BD6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnCancelSettings" Content="Отмена" Grid.Column="1" Style="{StaticResource TextBtn}" Margin="0,0,12,0"/>
                        <Button x:Name="BtnSaveSettings" Grid.Column="2" Style="{StaticResource ActionBtn}">
                            <TextBlock Text="Сохранить" Foreground="{StaticResource B.OnAccent}" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════ ТОСТ (живой отклик) ═══════════ -->
        <Border x:Name="Toast" Panel.ZIndex="300" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                Background="{StaticResource B.PanelHi}" BorderBrush="{StaticResource B.AccentEdge}"
                BorderThickness="1" CornerRadius="20" Padding="18,9" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <helpers:IconView Kind="check" IconSize="16" IconBrush="{StaticResource B.Ok}" x:Name="ToastIcon" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" Text="сохранено" Foreground="{StaticResource B.Ink}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
