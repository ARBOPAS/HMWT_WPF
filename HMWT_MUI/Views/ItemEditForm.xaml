<Window x:Class="HMWT_MUI.Views.ItemEditForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HMWT_MUI.Helpers"
        Icon="pack://application:,,,/Resources/HmwtLogo.ico"
        Title="Редактор предмета" Height="720" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource B.Panel}">

    <Window.Resources>
        <!-- Используем ресурсы из дизайн-системы -->



        <!-- СТИЛЬ: ComboBox (тёмный, УПРОЩЁННЫЙ) -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8E0D0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource B.Gold}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" 
                                            VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <!-- Стрелка живёт во второй колонке: без Grid.Column она
                                         попадала в колонку «*» и вставала по центру поля,
                                         поверх выбранного значения -->
                                    <helpers:IconView Grid.Column="1" Kind="caret" IconSize="16" Filled="True"
                                                      IconBrush="{StaticResource B.Ink}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!--
                              Кнопка раскрытия: список открывает именно она.
                              Без неё ComboBox не раскрывался по нажатию — на это
                              жаловались в бестиарии, здесь была та же ошибка.
                            -->
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" 
                           AllowsTransparency="True" 
                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                           Placement="Bottom" 
                           PlacementTarget="{Binding ElementName=bd}"
                           StaysOpen="False"
                           PopupAnimation="Slide">
                                <Border Background="{StaticResource B.Slate}" 
                                BorderBrush="{StaticResource B.Gold}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Margin="0,2,0,0" 
                                Padding="2" 
                                MinWidth="{TemplateBinding ActualWidth}" 
                                MaxHeight="250">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" 
                                                Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                        MaxHeight="230">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ: ComboBoxItem -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Arcane}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ: TextField -->
        <Style x:Key="TextField" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Gold}"/>
        </Style>

        <!-- СТИЛЬ: Чекбокс -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="cbBorder" Width="14" Height="14" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                                <helpers:IconView x:Name="checkMark" Kind="check" IconSize="11" Visibility="Collapsed" IconBrush="{StaticResource B.Gold}" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="cbBorder" Property="BorderBrush" Value="{StaticResource B.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ: CTA кнопка -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B.OnGold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource B.Gold}" CornerRadius="6" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ: Ghost кнопка -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B.Mute}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="16,12,12,10">
            <TextBlock x:Name="txtTitle" Text="РЕДАКТОР ПРЕДМЕТА" 
                       FontFamily="{StaticResource F.Display}" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource B.Gold}"/>
            <Button Width="28" Height="28" 
                    Style="{StaticResource GhostBtn}" 
                    HorizontalAlignment="Right"
                    Click="BtnClose_Click"><helpers:IconView Kind="close" IconSize="15" IconBrush="{StaticResource B.Mute}" VerticalAlignment="Center"/></Button>
        </Grid>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Название -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Название предмета" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtName" Height="32" Style="{StaticResource TextField}"/>
                </StackPanel>

                <!-- Категория + Редкость -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Категория" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbCategory" Height="32" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content="Оружие"/>
                            <ComboBoxItem Content="Броня"/>
                            <ComboBoxItem Content="Зелье"/>
                            <ComboBoxItem Content="Свиток"/>
                            <ComboBoxItem Content="Еда"/>
                            <ComboBoxItem Content="Квестовый"/>
                            <ComboBoxItem Content="Сокровище"/>
                            <ComboBoxItem Content="Прочее"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Редкость" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbRarity" Height="32" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content="Обычный"/>
                            <ComboBoxItem Content="Необычный"/>
                            <ComboBoxItem Content="Редкий"/>
                            <ComboBoxItem Content="Очень редкий"/>
                            <ComboBoxItem Content="Легендарный"/>
                            <ComboBoxItem Content="Артефакт"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Теги (компактно) -->
                <!-- Теги (ComboBox с чекбоксами) -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Теги" Foreground="{StaticResource B.Mute}" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtSelectedTagsCount" Grid.Column="1" Text="0 выбрано" 
                   Foreground="{StaticResource B.Frost}" FontSize="9" FontStyle="Italic"/>
                    </Grid>

                    <ComboBox x:Name="cbTags" Height="32" Style="{StaticResource DarkComboBox}" 
              MaxDropDownHeight="300">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding TagName}" 
                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{StaticResource B.Ink}"
                          Margin="0,3,0,3"
                          Cursor="Hand"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Описание" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescription" Height="50" Style="{StaticResource TextField}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Количество + Вес + Фото -->
                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Количество" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtQuantity" Height="32" Style="{StaticResource TextField}" Text="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Вес (кг)" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtWeight" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Фото" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <Border x:Name="photoBorder" Background="{StaticResource B.Slate}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Height="70" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="imgPreview" Stretch="Uniform"/>
                                <Button x:Name="btnSelectPhoto" Height="32" Width="32" 
                                    Style="{StaticResource GhostBtn}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,4,0" FontSize="16"><helpers:IconView Kind="image" IconSize="15" IconBrush="{StaticResource B.Ink}" VerticalAlignment="Center"/></Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Цена (3 колонки) -->
                <Grid Grid.Row="5" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Золото" Foreground="{StaticResource B.Gold}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtCostGold" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Серебро" Foreground="#C0C0C0" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtCostSilver" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="Медь" Foreground="#B87333" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtCostCopper" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- Характеристики -->
                <Grid Grid.Row="6" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Кости урона (1d8)" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDamageDice" Height="32" Style="{StaticResource TextField}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Тип урона" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbDamageType" Height="32" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="Рубящий"/>
                            <ComboBoxItem Content="Колющий"/>
                            <ComboBoxItem Content="Дробящий"/>
                            <ComboBoxItem Content="Огонь"/>
                            <ComboBoxItem Content="Холод"/>
                            <ComboBoxItem Content="Молния"/>
                            <ComboBoxItem Content="Кислота"/>
                            <ComboBoxItem Content="Яд"/>
                            <ComboBoxItem Content="Психическая"/>
                            <ComboBoxItem Content="Звук"/>
                            <ComboBoxItem Content="Сила"/>
                            <ComboBoxItem Content="Некротическая"/>
                            <ComboBoxItem Content="Излучение"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Бонус КД + Заряды -->
                <Grid Grid.Row="7" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Бонус КД" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtArmorBonus" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Заряды (макс)" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtMaxCharges" Height="32" Style="{StaticResource TextField}" Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- Чекбокс + Заметки -->
                <Grid Grid.Row="8" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkIsStackable" 
                              Content="Можно складывать в стак" 
                              Style="{StaticResource DarkCheckBox}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Заметки" Foreground="{StaticResource B.Mute}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNotes" Height="32" Style="{StaticResource TextField}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    x:Name="btnCancel" 
                    Content="Отмена" 
                    Height="38" 
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostBtn}"
                    BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1"/>

            <Button Grid.Column="1" 
                    x:Name="btnSave" 
                    
                    Height="38" 
                    Margin="8,0,0,0"
                    Style="{StaticResource ActionBtn}"><StackPanel Orientation="Horizontal"><helpers:IconView Kind="save" IconSize="15" IconBrush="{StaticResource B.Void}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
    </Grid>
</Window>
