<UserControl x:Class="HMWT_MUI.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:HMWT_MUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Кнопка в стиле приложения (в этой вью свои ресурсы не объявлены) -->
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ШАПКА: СТАТУС, КЛЮЧ, ВЫХОД ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtRoomTitle" Text="ОТРЯД" FontFamily="{StaticResource F.Display}"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
                    <Border x:Name="brStatusDot" Width="10" Height="10" CornerRadius="5" Margin="12,0,8,0"
                            Background="{StaticResource B.Mute}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRoomStatus" Text="Не подключено" Foreground="{StaticResource B.Mute}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Ключ:" Foreground="{StaticResource B.Mute}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0" x:Name="lblKeyCaption"/>
                    <TextBlock x:Name="txtRoomKey" Text="—" FontFamily="{StaticResource F.Display}" FontSize="14"
                               FontWeight="Bold" Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"/>
                    <TextBlock Text="Адрес:" Foreground="{StaticResource B.Mute}" FontSize="11"
                               VerticalAlignment="Center" Margin="20,0,8,0" x:Name="lblHostCaption"
                               ToolTip="Локальный адрес — для игры в одной сети. Для интернета смотрите строку ниже"/>
                    <TextBlock x:Name="txtHostAddress" Text="—" FontSize="12"
                               Foreground="{StaticResource B.Ink}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Громкость у каждого своя: в комнату не уходит, чтобы
                         наушники одного игрока не делали тише у всех. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="Общая громкость звука у вас. В комнату не передаётся.">
                        <TextBlock Text="Громкость" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="sldVolume" Width="96" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged"
                                ToolTip="Громкость музыки и звуков у вас"/>
                    </StackPanel>
                    <CheckBox x:Name="chkHiddenRolls" Content="Скрытые броски" Margin="0,0,14,0"
                              VerticalAlignment="Center" FontSize="12"
                              Foreground="{StaticResource B.Mute}" Visibility="Collapsed"
                              ToolTip="Броски ведущего и его неписей останутся только у него: игроки их не увидят"
                              Checked="ChkHiddenRolls_Changed" Unchecked="ChkHiddenRolls_Changed"/>
                    <Button x:Name="btnCopyKey" Content="Скопировать ключ" Style="{StaticResource RoomGhostBtn}"
                            Margin="0,0,8,0" ToolTip="Передайте ключ игрокам вместе с адресом"
                            Click="BtnCopyKey_Click"/>
                    <Button x:Name="btnLeaveRoom" Content="Выйти из отряда" Style="{StaticResource RoomGhostBtn}"
                            Foreground="{StaticResource B.Danger}" Click="BtnLeaveRoom_Click"/>
                    <!-- Подключение к чужой комнате прямо отсюда, чтобы не бегать в главное окно -->
                    <Button x:Name="btnJoinRoomTab" Height="30" Margin="0,0,8,0" Style="{StaticResource RoomGhostBtn}"
                            ToolTip="Подключиться к отряду по адресу и ключу" Click="BtnJoinRoomTab_Click">
                        <TextBlock Text="Подключиться" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ АДРЕС ДЛЯ ИНТЕРНЕТА (только у ведущего) ═══════════
             Пользователь просил показывать публичный IP при создании комнаты:
             локальный 192.168.x.x работает только внутри домашней сети, и без
             внешнего адреса друзья из интернета подключиться не могут. -->
        <Border x:Name="brPublicRow" Grid.Row="1" Background="{StaticResource B.PanelHi}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Для интернета:" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtPublicAddress" Text="неизвестен" FontFamily="{StaticResource F.Display}"
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource B.Frost}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="txtPublicHint" FontSize="10" Foreground="{StaticResource B.Mute}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0"
                               Text="Друзьям нужен проброс этого порта на роутере. Если адрес не определился — играйте по локальному адресу в одной сети."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCopyAddress" Content="Скопировать адрес" Style="{StaticResource RoomGhostBtn}"
                            Margin="0,0,8,0" ToolTip="Скопировать адрес и порт одной строкой: игрок вставит её в поле подключения"
                            Click="BtnCopyAddress_Click"/>
                    <Button x:Name="btnRefreshIp" Content="Обновить IP" Style="{StaticResource RoomGhostBtn}"
                            ToolTip="Запросить внешний адрес заново: у провайдера он может меняться"
                            Click="BtnRefreshIp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ ПОДКЛЮЧЕНИЕ К ЧУЖОМУ ОТРЯДУ ═══════════
             Раньше кнопка «Подключиться» открывала панель в главном окне, но
             главное окно при открытом листе персонажа скрыто — нажатие
             выглядело как «кнопка не работает». Теперь поля подключения
             живут прямо здесь. -->
        <Border x:Name="brJoinPanel" Grid.Row="2" Background="{StaticResource B.PanelHi}"
                BorderBrush="{StaticResource B.AccentEdge}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Подключение к отряду" FontFamily="{StaticResource F.Display}"
                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource B.Accent}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="spRecentRooms" Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="Недавние:" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbRecentRooms" Style="{StaticResource SetCombo}"
                                  Width="300" Height="28"
                                  SelectionChanged="CmbRecentRooms_Changed"
                                  ToolTip="Комнаты, к которым уже подключались: выбор заполнит адрес и ключ"/>
                        <Button x:Name="btnForgetRoom" Content="Забыть" Style="{StaticResource RoomGhostBtn}"
                                Margin="8,0,0,0" Click="BtnForgetRoom_Click"
                                ToolTip="Убрать выбранную комнату из истории"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Адрес и порт:" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtJoinHost" Style="{StaticResource RoomField}" Width="200" MinHeight="34"
                                 KeyDown="JoinField_KeyDown"
                                 ToolTip="Например 192.168.1.5:47777"/>
                        <TextBlock Text="Ключ:" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <TextBox x:Name="txtJoinKey" Style="{StaticResource RoomField}" Width="170" MinHeight="34"
                                 KeyDown="JoinField_KeyDown"
                                 ToolTip="Например K7M2-XP9Q-RT4W"/>
                    </StackPanel>
                    <TextBlock x:Name="txtJoinHint"
                               Text="Можно вставить всю строку от ведущего — ключ и адрес разберутся сами"
                               FontSize="10.5" Foreground="{StaticResource B.Mute}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="btnJoinConnect" Content="Подключиться" Style="{StaticResource RoomActionBtn}"
                            MinWidth="120" Margin="0,0,8,0" Click="BtnJoinConnect_Click"/>
                    <Button x:Name="btnJoinCancel" Content="Отмена" Style="{StaticResource RoomGhostBtn}"
                            Click="BtnJoinCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ УЧАСТНИКИ И ЛЕНТА ═══════════ -->
        <Grid Grid.Row="3" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Колонка участников сжимается на узких экранах и не даёт
                     ленте ужаться до нечитаемой ширины -->
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="340"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Участники -->
            <Border Grid.Column="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="txtPlayersHeader" Text="УЧАСТНИКИ" FontFamily="{StaticResource F.Display}"
                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                        <TextBlock Grid.Column="1" x:Name="txtPlayersHint" Text="" Foreground="{StaticResource B.Mute}"
                                   FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spPlayers"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Общая лента: броски, чат, системные события -->
            <Border Grid.Column="1" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инициатива: ведущий ведёт бой у себя, остальные видят порядок хода.
                         Блок скрыт, пока бой не начат, поэтому лента не съезжает. -->
                    <Border x:Name="brInitiative" Grid.Row="0" Visibility="Collapsed"
                            Background="{StaticResource B.PanelHi}" BorderBrush="{StaticResource B.AccentEdge}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ИНИЦИАТИВА" FontFamily="{StaticResource F.Display}"
                                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                                <TextBlock Grid.Column="1" x:Name="txtInitiativeRound" Text="" FontSize="11"
                                           Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel x:Name="spInitiative"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ОБЩАЯ ЛЕНТА" FontFamily="{StaticResource F.Display}"
                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                        <TextBlock Grid.Column="1" x:Name="txtFeedHint" Text="" Foreground="{StaticResource B.Mute}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="feedScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="spFeed"/>
                        </ScrollViewer>
                        <!-- WebView2 должен получить настоящее окно ещё до первой
                             навигации: держим его видимым 1×1, а после ready
                             растягиваем на всю ленту. -->
                        <controls:ChatWebView x:Name="ChatWeb" Width="1" Height="1"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Opacity="0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ ВВОД СООБЩЕНИЯ ═══════════ -->
        <Border Grid.Row="4" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Достаточная высота для текста: 36 пикселей не хватало, и вводимое
                     сообщение не отображалось. MinWidth у кнопки не даёт ей сжаться
                     на узких экранах, а поле растягивается по ширине -->
                <TextBox Grid.Column="0" x:Name="txtChatInput" Style="{StaticResource RoomField}"
                         MinHeight="46" MaxHeight="120" AcceptsReturn="False" TextWrapping="NoWrap"
                         ToolTip="Enter — отправить" KeyDown="TxtChatInput_KeyDown"/>
                <Button Grid.Column="1" x:Name="btnAttachImage" Content="Картинка" Style="{StaticResource RoomGhostBtn}"
                        Margin="10,0,0,0" MinWidth="96" MinHeight="46" Click="BtnAttachImage_Click"
                        ToolTip="Отправить картинку или гифку в чат"/>
                <Button Grid.Column="2" x:Name="btnSendChat" Content="Отправить" Style="{StaticResource RoomActionBtn}"
                        Margin="8,0,0,0" MinWidth="120" MinHeight="46" Click="BtnSendChat_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
