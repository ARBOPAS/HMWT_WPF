<UserControl x:Class="HMWT_MUI.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Кнопка в стиле приложения (в этой вью свои ресурсы не объявлены) -->
        <Style x:Key="RoomActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Foreground" Value="{StaticResource B.OnAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource B.Accent}" BorderBrush="{StaticResource B.Accent}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoomGhostBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource B.Slate}"
                                BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.PanelHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoomField" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource B.Slate}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- ScrollViewer растягивается по высоте: с VerticalAlignment=Center
                                 и отступами текст не помещался в поле и был не виден -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ШАПКА: СТАТУС, КЛЮЧ, ВЫХОД ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtRoomTitle" Text="ОТРЯД" FontFamily="{StaticResource F.Display}"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
                    <Border x:Name="brStatusDot" Width="10" Height="10" CornerRadius="5" Margin="12,0,8,0"
                            Background="{StaticResource B.Mute}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRoomStatus" Text="Не подключено" Foreground="{StaticResource B.Mute}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Ключ:" Foreground="{StaticResource B.Mute}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0" x:Name="lblKeyCaption"/>
                    <TextBlock x:Name="txtRoomKey" Text="—" FontFamily="{StaticResource F.Display}" FontSize="14"
                               FontWeight="Bold" Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"/>
                    <TextBlock Text="Адрес:" Foreground="{StaticResource B.Mute}" FontSize="11"
                               VerticalAlignment="Center" Margin="20,0,8,0" x:Name="lblHostCaption"
                               ToolTip="Локальный адрес — для игры в одной сети. Для интернета смотрите строку ниже"/>
                    <TextBlock x:Name="txtHostAddress" Text="—" FontSize="12"
                               Foreground="{StaticResource B.Ink}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnCopyKey" Content="Скопировать ключ" Style="{StaticResource RoomGhostBtn}"
                            Margin="0,0,8,0" ToolTip="Передайте ключ игрокам вместе с адресом"
                            Click="BtnCopyKey_Click"/>
                    <Button x:Name="btnLeaveRoom" Content="Выйти из отряда" Style="{StaticResource RoomGhostBtn}"
                            Foreground="{StaticResource B.Danger}" Click="BtnLeaveRoom_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ АДРЕС ДЛЯ ИНТЕРНЕТА (только у ведущего) ═══════════
             Пользователь просил показывать публичный IP при создании комнаты:
             локальный 192.168.x.x работает только внутри домашней сети, и без
             внешнего адреса друзья из интернета подключиться не могут. -->
        <Border x:Name="brPublicRow" Grid.Row="1" Background="{StaticResource B.PanelHi}"
                BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Для интернета:" FontSize="11" Foreground="{StaticResource B.Mute}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtPublicAddress" Text="неизвестен" FontFamily="{StaticResource F.Display}"
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource B.Frost}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="txtPublicHint" FontSize="10" Foreground="{StaticResource B.Mute}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0"
                               Text="Друзьям нужен проброс этого порта на роутере. Если адрес не определился — играйте по локальному адресу в одной сети."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCopyAddress" Content="Скопировать адрес" Style="{StaticResource RoomGhostBtn}"
                            Margin="0,0,8,0" ToolTip="Скопировать адрес и порт одной строкой: игрок вставит её в поле подключения"
                            Click="BtnCopyAddress_Click"/>
                    <Button x:Name="btnRefreshIp" Content="Обновить IP" Style="{StaticResource RoomGhostBtn}"
                            ToolTip="Запросить внешний адрес заново: у провайдера он может меняться"
                            Click="BtnRefreshIp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ УЧАСТНИКИ И ЛЕНТА ═══════════ -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Колонка участников сжимается на узких экранах и не даёт
                     ленте ужаться до нечитаемой ширины -->
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="340"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Участники -->
            <Border Grid.Column="0" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="txtPlayersHeader" Text="УЧАСТНИКИ" FontFamily="{StaticResource F.Display}"
                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Accent}" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spPlayers"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Общая лента: броски, чат, системные события -->
            <Border Grid.Column="1" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Инициатива: ведущий ведёт бой у себя, остальные видят порядок хода.
                         Блок скрыт, пока бой не начат, поэтому лента не съезжает. -->
                    <Border x:Name="brInitiative" Grid.Row="0" Visibility="Collapsed"
                            Background="{StaticResource B.PanelHi}" BorderBrush="{StaticResource B.AccentEdge}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ИНИЦИАТИВА" FontFamily="{StaticResource F.Display}"
                                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                                <TextBlock Grid.Column="1" x:Name="txtInitiativeRound" Text="" FontSize="11"
                                           Foreground="{StaticResource B.Frost}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel x:Name="spInitiative"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ОБЩАЯ ЛЕНТА" FontFamily="{StaticResource F.Display}"
                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Accent}"/>
                        <TextBlock Grid.Column="1" x:Name="txtFeedHint" Text="" Foreground="{StaticResource B.Mute}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer x:Name="feedScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spFeed"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ ВВОД СООБЩЕНИЯ ═══════════ -->
        <Border Grid.Row="3" Background="{StaticResource B.Panel}" BorderBrush="{StaticResource B.Line}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Достаточная высота для текста: 36 пикселей не хватало, и вводимое
                     сообщение не отображалось. MinWidth у кнопки не даёт ей сжаться
                     на узких экранах, а поле растягивается по ширине -->
                <TextBox Grid.Column="0" x:Name="txtChatInput" Style="{StaticResource RoomField}"
                         MinHeight="46" MaxHeight="120" AcceptsReturn="False" TextWrapping="NoWrap"
                         ToolTip="Enter — отправить" KeyDown="TxtChatInput_KeyDown"/>
                <Button Grid.Column="1" x:Name="btnSendChat" Content="Отправить" Style="{StaticResource RoomActionBtn}"
                        Margin="10,0,0,0" MinWidth="130" MinHeight="46" Click="BtnSendChat_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
