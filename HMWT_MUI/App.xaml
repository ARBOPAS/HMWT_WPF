<Application x:Class="HMWT_MUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HMWT_MUI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Порядок обязателен: сначала палитра, потом стили.

                  Стили подставляют цвета через StaticResource в момент загрузки
                  словаря, поэтому палитра должна быть уже доступна. Тема меняется
                  подменой только первой строки — см. App.ApplyTheme.
                -->
                <ResourceDictionary Source="Resources/Palette.Dark.xaml"/>
                <ResourceDictionary Source="Resources/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
