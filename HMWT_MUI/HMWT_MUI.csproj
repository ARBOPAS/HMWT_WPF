    <!--
      Файлы справочников (Data/srd/*.json) НЕ распространяются вместе с проектом:
      их тексты принадлежат издателям. Файлы лежат локально у того, кто их
      подготовил, в git их нет (см. .gitignore), а пользователь подключает свой
      файл через импорт в приложении.

      Условие Exists у CopyToOutputDirectory: без файлов сборка проходит
      нормально, с файлами — они копируются в выходную папку.
    -->
    <None Include="Data\srd\backgrounds.json" />
    <None Include="Data\srd\classes.json" />
    <None Include="Data\srd\items.json">
